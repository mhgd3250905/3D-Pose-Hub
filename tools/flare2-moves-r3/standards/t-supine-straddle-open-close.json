  {
   "id": "closed_together",
   "label": "并拢：两腿夹角（并拢段最大）",
   "metric": "straddleDeg",
   "agg": "max",
   "unit": "°",
   "phase": "closed",
   "max": 10
  },
  {
   "id": "closed_vertical",
   "label": "并拢：腿竖直上举（髋→踝 与竖直向上夹角，legElev 180 = 竖直向上）",
   "metric": "legElevMin",
   "agg": "min",
   "unit": "°",
   "phase": "closed",
   "min": 170
  },
  {
   "id": "open_wide",
   "label": "大分腿：两腿夹角（打开停顿段最小）",
   "metric": "straddleDeg",
   "agg": "min",
   "unit": "°",
   "phase": "open",
   "min": 70,
   "max": 95
  },
  {
   "id": "open_side",
   "label": "向两侧打开而不是往头/脚方向倒（打开时每条腿与竖直夹角 ≈ 外展角：legElev 最小）",
