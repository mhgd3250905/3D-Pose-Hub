{
 "format": "flare2-moves-standard@1",
 "id": "t-supine-straddle-open-close",
 "nameZh": "仰卧直腿大分腿慢开合",
 "doc": "tools/flare2-moves-r3/standards/t-supine-straddle-open-close.md",
 "phases": {
  "closed": "仰卧，双腿伸直并拢竖直上举（髋屈约 90°），手臂放身体两侧掌心贴垫",
  "open": "大分腿停顿：两腿向两侧打开，两腿夹角约 80°，膝仍伸直",
  "all": "整段：骨盆/背贴垫不动，膝伸直，慢开慢合"
 },
 "series": [
  "straddleDeg",
  "legElevMin",
  "kneeMin",
  "seatFloorMm",
  "torsoFloorMm",
  "pelvisRotDeg",
  "handFloorMm",
  "headFloorMm"
 ],
