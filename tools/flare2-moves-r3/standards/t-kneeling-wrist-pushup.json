{
 "format": "flare2-moves-standard@1",
 "id": "t-kneeling-wrist-pushup",
 "nameZh": "跪姿手腕俯卧撑",
 "doc": "tools/flare2-moves-r3/standards/t-kneeling-wrist-pushup.md",
 "phases": {
  "flat": "手掌平贴垫子",
  "top": "顶端：掌根抬到指根，只剩手指（指根以下）压在垫上，锁肘",
  "lower": "3 秒慢放回平贴",
  "all": "整段：锁肘、手指平贴不动、膝-髋-肩一条线"
 },
 "series": [
  "elbowMin",
  "heelLiftMin",
  "heelLiftMax",
  "handFloorMm",
  "handAxisFwdDevMax",
  "hipOffsetKneeMm",
  "shoulderLeadCm",
  "kneeFloorMinMm",
  "fingerDevMax"
 ],
 "checks": [
  {
   "id": "locked",
   "label": "全程锁肘（两肘最小角）",
   "metric": "elbowMin",
   "agg": "min",
   "unit": "°",
   "phase": "all",
   "min": 175
  },
  {
   "id": "lift_top_lo",
   "label": "顶端掌根抬到指根（掌骨线抬起角，两手较小者）",
   "metric": "heelLiftMin",
   "agg": "min",
   "unit": "°",
   "phase": "top",
   "min": 50
  },
  {
   "id": "lift_top_hi",
   "label": "顶端不过度（两手较大者）",
   "metric": "heelLiftMax",
   "agg": "max",
   "unit": "°",
   "phase": "top",
   "max": 65
  },
  {
   "id": "flat_lo",
   "label": "放下：手掌平贴（掌骨线角，最小）",
   "metric": "heelLiftMin",
   "agg": "min",
   "unit": "°",
   "phase": "flat",
   "min": -8
  },
  {
   "id": "flat_hi",
   "label": "放下：手掌平贴（最大）",
   "metric": "heelLiftMax",
   "agg": "max",
   "unit": "°",
   "phase": "flat",
   "max": 6
  },
  {
   "id": "sym",
   "label": "双手同时（左右抬起角差）",
   "metric": "heelLiftAsym",
   "agg": "max",
   "unit": "°",
   "phase": "all",
   "max": 3
  },
  {
   "id": "slow_lower",
   "label": "慢放 3 秒（缓起缓停；掌骨线角从 97% 降到 3% 的时间 ≥ 2.2 秒）",
