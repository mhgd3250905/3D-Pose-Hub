   "metric": "heelLiftMin",
   "dir": "down",
   "frac": [
    0.03,
    0.97
   ],
   "min": 2.2,
   "unit": "s"
  },
  {
   "id": "top_pause",
   "label": "顶端停顿（抬起角在最大值 3° 内的时间）",
   "kind": "plateau",
   "metric": "heelLiftMin",
   "ref": "max",
   "tol": 3,
   "min": 0.4,
   "unit": "s"
  },
  {
   "id": "reps",
   "label": "每循环 2 次",
   "kind": "reps",
   "metric": "heelLiftMin",
   "ref": "max",
   "tol": 3,
   "min": 2,
   "max": 2,
   "unit": "次"
  },
  {
   "id": "fingers_floor_min",
   "label": "手指不穿垫（手最低点）",
