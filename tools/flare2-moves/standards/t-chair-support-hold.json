{
 "format": "flare2-moves-standard@1",
 "id": "t-chair-support-hold",
 "nameZh": "双椅直臂支撑（肩胛下压）",
 "doc": "tools/flare2-moves/standards/t-chair-support-hold.md",
 "phases": {
  "relaxed": "放松：直臂撑在两椅面，肩自然上耸（靠近耳朵），脚尖轻点地",
  "hold": "保持：肩胛下压（肩远离耳朵），身体随之升高约 4 cm，双脚离地，静止计时"
 },
 "series": [
  "elbowMin",
  "scapUp",
  "chestHeightMm",
  "footClearMm",
  "boxHandMinMm",
  "boxBodyMinMm",
  "thoraxPitchDeg"
 ],
 "checks": [
  {
   "id": "elbow_lock",
   "label": "全程锁肘（两肘最小角）",
   "metric": "elbowMin",
   "agg": "min",
   "min": 175,
   "unit": "°"
  },
  {
   "id": "hands_on_seat",
   "label": "手掌平放在椅面上（V5 手最低点相对椅面，全程）",
   "metric": "boxHandMinMm",
   "agg": "min",
   "min": -1,
   "max": 3,
   "unit": "mm"
  },
  {
   "id": "hands_on_seat_max",
   "label": "手掌不离开椅面（全程最大）",
   "metric": "boxHandMinMm",
   "agg": "max",
   "min": -1,
   "max": 3,
   "unit": "mm"
  },
  {
   "id": "contacts_hands",
   "label": "手掌不滑（V5 手骨漂移）",
   "kind": "pins",
   "which": "hands",
   "max": 2,
   "unit": "mm"
  },
  {
   "id": "palm_flat",
   "label": "手掌不翻转（手骨转角变化）",
