   "agg": "range",
   "max": 5,
   "unit": "°"
  },
  {
   "id": "elbow_skin_twistR",
   "label": "右肘部皮肤不拧：肘带（前臂长 −8%…+4%）蒙皮顶点绕轴偏转（最大绝对值）",
   "metric": "elbowSkinTwistAbsR",
   "agg": "max",
   "max": 5,
   "unit": "°"
  },
  {
   "id": "prox_forearm_skin_twistR",
   "label": "右近肘前臂皮肤少转：前臂 4%…15% 段蒙皮顶点绕轴偏转（最大绝对值）",
   "metric": "proxForearmSkinTwistAbsR",
   "agg": "max",
   "max": 10,
   "unit": "°"
  },
  {
   "id": "elbow_no_pinchR",
