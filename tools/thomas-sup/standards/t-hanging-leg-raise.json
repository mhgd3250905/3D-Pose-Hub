{
 "format": "thomas-sup-standard@1",
 "id": "t-hanging-leg-raise",
 "nameZh": "悬垂举腿",
 "doc": "tools/thomas-sup/standards/t-hanging-leg-raise.md",
 "phases": {
  "hang": "主动悬垂（肩胛下沉），腿并拢直垂，身体静止",
  "top": "直腿抬到略高于水平，停 1 s"
 },
 "series": [
  "legElevMin",
  "comFwdCm",
  "thoraxPitchDeg",
  "pelvisPitchDeg",
  "scapUp",
  "anklesApartCm"
 ],
 "checks": [
  {
   "id": "elbow_lock",
   "label": "全程锁肘（两肘最小角）",
   "metric": "elbowMin",
   "agg": "min",
   "min": 172,
   "unit": "°"
  },
  {
   "id": "knee_straight",
   "label": "直腿（两膝最小角）",
   "metric": "kneeMin",
   "agg": "min",
   "min": 170,
   "unit": "°"
  },
  {
   "id": "top_level",
   "label": "顶端：腿抬到至少水平（髋→踝与竖直向下夹角，较低一腿）",
   "metric": "legElevMin",
   "agg": "max",
   "min": 90,
   "max": 110,
   "unit": "°",
   "phase": "top"
  },
  {
   "id": "hang_down",
   "label": "悬垂：腿自然下垂",
   "metric": "legElevMin",
   "agg": "max",
   "max": 10,
   "unit": "°",
   "phase": "hang"
  },
  {
   "id": "top_hold",
   "label": "顶端停留（腿在最高 2° 内）",
   "kind": "plateau",
   "metric": "legElevMin",
   "ref": "max",
   "tol": 2,
   "min": 0.9,
   "max": 1.6,
   "unit": "s"
  },
  {
   "id": "raise_time",
   "label": "抬腿用时（2%→98%，不甩）",
   "kind": "transition",
   "dir": "up",
   "metric": "legElevMin",
   "min": 1.2,
   "unit": "s",
   "frac": [
    0.02,
    0.98
   ]
  },
  {
   "id": "lower_time",
   "label": "放腿用时（最高 98%→2%，约 3 秒控制放下，两端缓入缓出）",
   "kind": "transition",
   "dir": "down",
   "metric": "legElevMin",
   "min": 2.4,
   "unit": "s",
   "frac": [
    0.02,
    0.98
   ]
  },
  {
   "id": "reps_per_loop",
   "label": "每 8 s 循环次数",
   "kind": "reps",
   "metric": "legElevMin",
   "ref": "max",
   "tol": 2,
   "min": 1,
   "max": 1,
   "unit": "次"
  },
  {
   "id": "no_swing_back",
   "label": "不摆荡：重心在单杠下（最靠后）",
   "metric": "comFwdCm",
   "agg": "min",
   "min": -2,
   "unit": "cm"
  },
  {
   "id": "no_swing_fwd",
   "label": "不摆荡：重心在单杠下（最靠前）",
   "metric": "comFwdCm",
   "agg": "max",
   "max": 2,
   "unit": "cm"
  },
  {
   "id": "trunk_steady",
   "label": "躯干不晃：胸廓前后倾变化",
   "metric": "thoraxPitchDeg",
   "agg": "range",
   "max": 15,
   "unit": "°"
  },
  {
   "id": "active_hang",
   "label": "主动悬垂：肩关节相对胸廓下沉（最高处）",
   "metric": "scapUp",
   "agg": "max",
   "max": -10,
   "unit": "mm"
  },
  {
   "id": "no_shrug",
   "label": "肩不耸：肩关节相对胸廓上下变化",
   "metric": "scapUp",
   "agg": "range",
   "max": 3,
   "unit": "mm"
  },
  {
   "id": "pelvis_tuck",
   "label": "顶端骨盆后倾（骨盆上缘向后，最大）",
   "metric": "pelvisPitchDeg",
   "agg": "max",
   "max": -5,
   "unit": "°",
   "phase": "top"
  },
  {
   "id": "legs_together",
   "label": "两腿并拢（两踝间距最大）",
   "metric": "anklesApartCm",
   "agg": "max",
   "max": 20,
   "unit": "cm"
  },
  {
   "id": "head_neutral",
   "label": "头中立（头与胸廓夹角）",
   "metric": "headVsTrunkDeg",
   "agg": "max",
   "max": 15,
   "unit": "°"
  },
  {
   "id": "feet_clear",
   "label": "脚离地（脚最低点）",
   "metric": "footClearMm",
   "agg": "min",
   "min": 50,
   "unit": "mm"
  },
  {
   "id": "contacts",
   "label": "手不在杠上滑（V5 手骨漂移）",
   "kind": "pins",
   "which": "hands",
   "max": 5,
   "unit": "mm"
  },
  {
   "id": "v5_matches_hub",
   "label": "V5 身体与求解姿态一致（最大关节偏差）",
   "kind": "summary",
   "path": "maxPosErrMm",
   "max": 2,
   "unit": "mm"
  }
 ]
}
