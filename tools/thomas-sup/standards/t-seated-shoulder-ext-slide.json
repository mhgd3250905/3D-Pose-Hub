{
 "format": "thomas-sup-standard@1",
 "id": "t-seated-shoulder-ext-slide",
 "nameZh": "后撑肩伸展滑行",
 "doc": "tools/thomas-sup/standards/t-seated-shoulder-ext-slide.md",
 "phases": {
  "start": "坐姿，手在身后撑地、指尖朝后，手臂伸直",
  "hold": "臀部前滑到肩后伸末端，主动撑住 1.5 s（肩下沉、胸口挺起）"
 },
 "series": [
  "shoulderExtMin",
  "gazeBelowHorizDeg",
  "headVsTrunkDeg",
  "scapUp",
  "trunkFlexDeg",
  "seatContactMm"
 ],
 "checks": [
  {
   "id": "elbow_lock",
   "label": "全程锁肘（两肘最小角）",
   "metric": "elbowMin",
   "agg": "min",
   "min": 172,
   "unit": "°"
  },
  {
   "id": "start_ext",
   "label": "起始：肩后伸角（两侧较小者）",
   "metric": "shoulderExtMin",
   "agg": "min",
   "min": 25,
   "max": 45,
   "unit": "°",
   "phase": "start"
  },
  {
   "id": "hold_ext_min",
   "label": "末端：肩后伸角（保持段最小）",
   "metric": "shoulderExtMin",
   "agg": "min",
   "min": 50,
   "max": 65,
   "unit": "°",
   "phase": "hold"
  },
  {
   "id": "hold_ext_max",
   "label": "末端：肩后伸角（保持段最大，不超过常模上限）",
   "metric": "shoulderExtMax",
   "agg": "max",
   "min": 50,
   "max": 65,
   "unit": "°",
   "phase": "hold"
  },
  {
   "id": "ext_gain",
   "label": "滑出带来的肩后伸增加（末端−起始）",
   "kind": "diff",
   "metric": "shoulderExtMin",
   "phase": "hold",
   "agg": "mean",
   "phase2": "start",
   "agg2": "mean",
   "min": 20,
   "unit": "°"
  },
  {
   "id": "hold_time",
   "label": "末端保持（肩后伸在最大值 1° 内）",
   "kind": "plateau",
   "metric": "shoulderExtMin",
   "ref": "max",
   "tol": 1.0,
   "min": 1.2,
   "max": 2.5,
   "unit": "s"
  },
  {
   "id": "no_bounce",
   "label": "不弹不甩：肩后伸 10%→90% 最短用时",
   "kind": "transition",
   "metric": "shoulderExtMin",
   "min": 1.2,
   "unit": "s"
  },
  {
   "id": "reps_per_loop",
   "label": "每 8 s 循环次数",
   "kind": "reps",
   "metric": "shoulderExtMin",
   "ref": "max",
   "tol": 1.0,
   "min": 1,
   "max": 1,
   "unit": "次"
  },
  {
   "id": "shoulders_down",
   "label": "肩不耸：肩关节相对胸廓（最高处，负 = 下沉）",
   "metric": "scapUp",
   "agg": "max",
   "max": -5,
   "unit": "mm"
  },
  {
   "id": "no_shrug",
   "label": "肩不耸：肩关节相对胸廓上下变化",
   "metric": "scapUp",
   "agg": "range",
   "max": 5,
   "unit": "mm"
  },
  {
   "id": "chest_up",
   "label": "胸口挺起：胸廓相对骨盆不弓背（最大屈曲）",
   "metric": "trunkFlexDeg",
   "agg": "max",
   "max": 0,
   "unit": "°"
  },
  {
   "id": "head_tuck",
   "label": "头：下巴微收（头相对胸廓前屈，最小）",
   "metric": "headVsTrunkDeg",
   "agg": "min",
   "min": 10,
   "max": 25,
   "unit": "°"
  },
  {
   "id": "gaze_up",
   "label": "头不后仰：视线高于水平（最大）",
   "metric": "gazeBelowHorizDeg",
   "agg": "min",
   "min": -20,
   "unit": "°"
  },
  {
   "id": "gaze_down",
   "label": "头不低：视线低于水平（最大）",
   "metric": "gazeBelowHorizDeg",
   "agg": "max",
   "max": 10,
   "unit": "°"
  },
  {
   "id": "contacts",
   "label": "手掌（V5 手骨）、脚不滑动（最大漂移）",
   "kind": "pins",
   "max": 5,
   "unit": "mm"
  },
  {
   "id": "hands_no_clip",
   "label": "手不穿垫（手最低点）",
   "metric": "handFloorMm",
   "agg": "min",
   "min": -2,
   "unit": "mm"
  },
  {
   "id": "feet_no_clip",
   "label": "脚不穿垫（脚最低点）",
   "metric": "footClearMm",
   "agg": "min",
   "min": -2,
   "unit": "mm"
  },
  {
   "id": "seat_on_mat",
   "label": "臀/大腿后侧坐在垫上（最低点，最低）",
   "metric": "seatContactMm",
   "agg": "min",
   "min": -2,
   "unit": "mm"
  },
  {
   "id": "seat_on_mat_max",
   "label": "臀/大腿后侧坐在垫上（最低点，最高 = 不悬空）",
   "metric": "seatContactMm",
   "agg": "max",
   "max": 4,
   "unit": "mm"
  },
  {
   "id": "v5_matches_hub",
   "label": "V5 身体与求解姿态一致（最大关节偏差）",
   "kind": "summary",
   "path": "maxPosErrMm",
   "max": 2,
   "unit": "mm"
  }
 ]
}
