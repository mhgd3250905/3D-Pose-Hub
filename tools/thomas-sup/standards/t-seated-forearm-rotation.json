{
 "format": "thomas-sup-standard@1",
 "id": "t-seated-forearm-rotation",
 "nameZh": "坐姿哑铃翻手腕",
 "doc": "tools/thomas-sup/standards/t-seated-forearm-rotation.md",
 "phases": {
  "up": "掌心朝上（前臂旋后到底）",
  "down": "掌心朝下（前臂旋前到底）"
 },
 "series": [
  "supR",
  "wristFlexR",
  "wristDevR",
  "forearmPitchDeg"
 ],
 "checks": [
  {
   "id": "sup_end",
   "label": "掌心朝上端：前臂旋转角（最大，+90 = 掌心正朝上）",
   "metric": "supR",
   "agg": "max",
   "min": 75,
   "max": 92,
   "unit": "°"
  },
  {
   "id": "pro_end",
   "label": "掌心朝下端：前臂旋转角（最小，−90 = 掌心正朝下）",
   "metric": "supR",
   "agg": "min",
   "min": -92,
   "max": -75,
   "unit": "°"
  },
  {
   "id": "rot_total",
   "label": "翻转全幅（朝上→朝下）",
   "metric": "supR",
   "agg": "range",
   "min": 150,
   "unit": "°"
  },
  {
   "id": "wrist_flex_max",
   "label": "只转不弯：腕屈伸（最大）",
   "metric": "wristFlexR",
   "agg": "max",
   "max": 10,
   "unit": "°"
  },
  {
   "id": "wrist_flex_min",
   "label": "只转不弯：腕屈伸（最小）",
   "metric": "wristFlexR",
   "agg": "min",
   "min": -10,
   "unit": "°"
  },
  {
   "id": "dev_max",
   "label": "只转不歪：腕侧偏（最大）",
   "metric": "wristDevR",
   "agg": "max",
   "max": 10,
   "unit": "°"
  },
  {
   "id": "dev_min",
   "label": "只转不歪：腕侧偏（最小）",
   "metric": "wristDevR",
   "agg": "min",
   "min": -10,
   "unit": "°"
  },
  {
   "id": "turn_down",
   "label": "翻下（朝上→朝下）5%→95% 用时",
   "metric": "supR",
   "kind": "transition",
   "dir": "down",
   "frac": [
    0.05,
    0.95
   ],
   "min": 1.4,
   "max": 2.6,
   "unit": "s"
  },
  {
   "id": "turn_up",
   "label": "翻回（朝下→朝上）5%→95% 用时",
   "metric": "supR",
   "kind": "transition",
   "dir": "up",
   "frac": [
    0.05,
    0.95
   ],
   "min": 1.4,
   "max": 2.8,
   "unit": "s"
  },
  {
   "id": "hold_up",
   "label": "掌心朝上停顿（在最大值 2° 内）",
   "metric": "supR",
   "kind": "plateau",
   "ref": "max",
   "tol": 2,
   "min": 0.4,
   "max": 1.8,
   "unit": "s"
  },
  {
   "id": "hold_down",
   "label": "掌心朝下停顿（在最小值 2° 内）",
   "metric": "supR",
   "kind": "plateau",
   "ref": "min",
   "tol": 2,
   "min": 0.4,
   "max": 1.8,
   "unit": "s"
  },
  {
   "id": "reps_per_loop",
   "label": "每 8 s 循环次数（一来一回 = 1 次）",
   "metric": "supR",
   "kind": "reps",
   "ref": "max",
   "tol": 2,
   "min": 1,
   "max": 1,
   "unit": "次"
  },
  {
   "id": "forearm_still",
   "label": "前臂不抬：前臂与水平夹角变化",
   "metric": "forearmPitchDeg",
   "agg": "range",
   "max": 0.5,
   "unit": "°"
  },
  {
   "id": "elbow_still",
   "label": "手肘不离开大腿（V5 前臂枢轴最大漂移）",
   "kind": "summary",
   "path": "pins.rightForearm:forearm-on-thigh.driftMm",
   "max": 2,
   "unit": "mm"
  },
  {
   "id": "wrist_still",
   "label": "转轴过前臂：手腕枢轴不动（最大漂移）",
   "kind": "summary",
   "path": "pins.rightHand:wrist-still.driftMm",
   "max": 2,
   "unit": "mm"
  },
  {
   "id": "forearm_on_thigh",
   "label": "前臂贴在大腿上：前臂下缘−大腿上缘（最低，负 = 压进）",
   "kind": "summary",
   "path": "gap.forearmR>thighR.min",
   "min": -5,
   "unit": "mm"
  },
  {
   "id": "forearm_on_thigh_max",
   "label": "前臂贴在大腿上（最高，不悬空）",
   "kind": "summary",
   "path": "gap.forearmR>thighR.max",
   "max": 3,
   "unit": "mm"
  },
  {
   "id": "left_hand_rest",
   "label": "左手放在左大腿上（间距最低）",
   "kind": "summary",
   "path": "gap.handL>thighL.min",
   "min": -5,
   "unit": "mm"
  },
  {
   "id": "left_hand_rest_max",
   "label": "左手放在左大腿上（间距最高）",
   "kind": "summary",
   "path": "gap.handL>thighL.max",
   "max": 3,
   "unit": "mm"
  },
  {
   "id": "left_hand_still",
   "label": "左手不动（最大漂移）",
   "kind": "summary",
   "path": "pins.leftHand:left-rest.driftMm",
   "max": 2,
   "unit": "mm"
  },
  {
   "id": "trunk_still",
   "label": "不甩动借力：胸廓高度变化（身体不动）",
   "metric": "chestHeightMm",
   "agg": "range",
   "max": 1,
   "unit": "mm"
  },
  {
   "id": "seat_on_bench",
   "label": "坐在凳上：大腿后侧最低点（凳面 440 mm）",
   "metric": "thighLowMm",
   "agg": "min",
   "min": 437,
   "max": 445,
   "unit": "mm"
  },
  {
   "id": "feet",
   "label": "双脚不滑（最大漂移）",
   "kind": "pins",
   "which": "feet",
   "max": 2,
   "unit": "mm"
  },
  {
   "id": "feet_no_clip",
   "label": "脚不穿地",
   "metric": "footClearMm",
   "agg": "min",
   "min": -2,
   "unit": "mm"
  },
  {
   "id": "v5_matches_hub",
   "label": "V5 身体与求解姿态一致（最大关节偏差）",
   "kind": "summary",
   "path": "maxPosErrMm",
   "max": 2,
   "unit": "mm"
  }
 ]
}
