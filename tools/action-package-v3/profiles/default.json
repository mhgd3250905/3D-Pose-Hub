    "themes": {"dark": "#101013", "light": "#f3f2ef"},
    "highlight": {"source": "body-highlight", "blendBrightness": 0.45},
    "coverSize": 720, "thumbnailSize": 240, "keyframeSize": 720, "transparentCoverSize": 1080,
    "keyframes": ["start", "peak", "end"],
    "framing": {"policy": "union-of-all-skins-all-frames-body-alpha", "padding": 0.08}
  }
