    "name": {
      "zh": "仰卧仙人掌开胸",
      "en": "Lying Cactus-Arm Chest Stretch"
    },
    "purpose": {
      "zh": "轻轻打开胸口和肩膀前侧",
      "en": "Gently open your chest and the fronts of your shoulders."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "手肘和手背贴地，双臂沿地面往头的方向滑",
          "en": "Keep elbows and hands on the floor and slide your arms toward your head"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "仰躺屈膝，双脚踩地，腰放松。",
          "en": "Lie on your back, knees bent, feet flat, lower back relaxed."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "有轻微拉伸感就停住，再慢慢滑回。",
          "en": "Stop at a mild stretch, then slide back down slowly."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "手臂离开地面硬撑",
        "en": "Lifting the arms off the floor and forcing it."
      },
      {
        "zh": "腰拱起来",
        "en": "Arching the lower back."
