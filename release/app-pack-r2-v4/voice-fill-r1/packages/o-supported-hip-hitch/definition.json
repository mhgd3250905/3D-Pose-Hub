    "name": {
      "zh": "扶椅单腿骨盆提拉",
      "en": "Chair-Supported Hip Hitch"
    },
    "purpose": {
      "zh": "练单腿站时骨盆左右不歪的控制",
      "en": "Train control to keep your pelvis level while standing on one leg."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "支撑腿站稳，另一侧骨盆慢慢提起",
          "en": "Stand firm on one leg and slowly lift the other hip"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "轻扶椅子，抬起的膝盖一直弯着。",
          "en": "Hold the chair lightly and keep the lifted knee bent."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "小幅度提起再放平，上身别侧弯。",
          "en": "Lift a little, lower to level, and keep your trunk upright."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "上身侧弯代替提骨盆",
        "en": "Leaning the trunk instead of lifting the hip."
      },
      {
        "zh": "支撑腿膝盖一弯一直地借力",
        "en": "Bending and straightening the standing knee to help."
      }
    ],
    "tags": {
