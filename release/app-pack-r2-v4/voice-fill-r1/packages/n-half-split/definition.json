  "definition": {
    "name": {
      "zh": "半跪半劈叉（扶砖）",
      "en": "Half-Kneeling Half Split (Blocks)"
    },
    "purpose": {
      "zh": "拉伸前腿的大腿后侧，为前后劈叉打基础",
      "en": "Stretch the back of your front thigh as a first step toward the front splits."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "臀部往后坐，前腿伸直，背拉长",
          "en": "Sit your hips back, straighten the front leg and keep your back long"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "后膝跪地，前脚跟着地、勾脚尖。",
          "en": "Kneel on the back knee with the front heel down and toes up."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "保持不动，慢慢呼吸，每次呼气再放松一点。",
          "en": "Stay still, breathe slowly, and relax a little deeper each time you breathe out."
        }
      },
      {
        "id": "cue4",
        "primary": false,
        "text": {
          "zh": "别来回颠，有拉伸感就够，别拉到疼。",
          "en": "Do not bounce; a clear stretch is enough, never pain."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "弓背去够脚",
        "en": "Rounding your back to reach the foot."
      },
      {
        "zh": "硬把前腿膝盖伸直",
        "en": "Forcing the front knee straight."
      },
      {
        "zh": "憋气或来回颠",
        "en": "Holding your breath or bouncing."
      }
    ],
    "tags": {
