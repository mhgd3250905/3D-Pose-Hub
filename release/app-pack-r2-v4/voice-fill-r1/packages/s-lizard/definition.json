  "definition": {
    "name": {
      "zh": "蜥蜴式低弓步",
      "en": "Lizard Lunge"
    },
    "purpose": {
      "zh": "拉伸后腿髋前侧和前腿大腿内侧",
      "en": "Stretch the front of your back hip and the inner thigh of your front leg."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "髋部慢慢往前往下沉",
          "en": "Let your hips sink slowly forward and down"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "前脚远远踩在前面，后膝跪地，双手扶砖。",
          "en": "Plant your front foot far forward, kneel on the back knee, hands on the blocks."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "保持不动，慢慢呼吸，每次呼气再放松一点。",
          "en": "Stay still, breathe slowly, and relax a little deeper each time you breathe out."
        }
      },
      {
        "id": "cue4",
        "primary": false,
        "text": {
          "zh": "别来回颠，有拉伸感就够，别拉到疼。",
          "en": "Do not bounce; a clear stretch is enough, never pain."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "前膝往里扣或远远超过脚尖",
        "en": "Letting the front knee cave in or drift far past your toes."
      },
      {
        "zh": "耸肩塌背",
        "en": "Shrugging and sagging your back."
      },
      {
        "zh": "憋气或来回颠",
        "en": "Holding your breath or bouncing."
      }
    ],
    "tags": {
      "category": "stretch",
      "activeMuscles": [
        "hip-flexors",
        "adductors"
      ],
      "synergistMuscles": [
        "glutes",
        "quadriceps"
      ],
      "equipment": [
        "yoga-blocks",
        "mat"
      ],
      "position": "half-kneeling",
      "difficulty": 2
    },
    "unilateral": true,
    "defaultDose": {
      "mode": "time",
      "sets": 2,
      "seconds": 45,
      "restSeconds": 15
    },
    "cautions": [
      {
        "zh": "跪地的膝盖下面垫软垫",
        "en": "Pad under the kneeling knee."
      },
      {
        "zh": "髋或大腿内侧疼时幅度小一点，还疼就停",
        "en": "If your hip or inner thigh hurts, move less far, and stop if it still hurts."
      }
    ],
    "startingSide": "left",
