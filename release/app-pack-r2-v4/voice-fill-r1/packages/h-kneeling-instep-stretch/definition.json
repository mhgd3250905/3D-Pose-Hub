    "name": {
      "zh": "跪姿脚背拉伸",
      "en": "Kneeling Top-of-Foot Stretch"
    },
    "purpose": {
      "zh": "拉伸脚背和小腿前面",
      "en": "Stretch the tops of your feet and the fronts of your shins."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "脚背贴地跪好，身体慢慢往后坐",
          "en": "Kneel with the tops of your feet down and slowly sit back"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "停住不动，慢慢呼吸。",
          "en": "Stay still and breathe slowly."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "每次呼气再放松一点，别来回颠。",
          "en": "Each time you breathe out, relax a little deeper. No bouncing."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "一下子重重坐下去",
        "en": "Dropping down hard."
      },
      {
        "zh": "憋气",
        "en": "Holding your breath."
      },
      {
        "zh": "来回颠着往下压",
        "en": "Bouncing to go deeper."
      }
    ],
    "tags": {
