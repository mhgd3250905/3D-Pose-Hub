  "definition": {
    "name": {
      "zh": "鸽子式",
      "en": "Pigeon Stretch"
    },
    "purpose": {
      "zh": "拉伸前腿的臀部和后腿的髋前侧",
      "en": "Stretch the glute of your front leg and the front of your back hip."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "前腿小腿横在身前，后腿往后伸直",
          "en": "Bring your front shin across and stretch the back leg behind you"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "双手扶砖，骨盆尽量摆正，别硬往下压。",
          "en": "Hands on the blocks, hips as square as you can, do not force them down."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "保持不动，慢慢呼吸，每次呼气再放松一点。",
          "en": "Stay still, breathe slowly, and relax a little deeper each time you breathe out."
        }
      },
      {
        "id": "cue4",
        "primary": false,
        "text": {
          "zh": "别来回颠，有拉伸感就够，别拉到疼。",
          "en": "Do not bounce; a clear stretch is enough, never pain."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "骨盆歪向一边",
        "en": "Letting your hips tilt to one side."
      },
      {
        "zh": "硬压前腿膝盖",
        "en": "Forcing the front knee down."
      },
      {
        "zh": "憋气或来回颠",
        "en": "Holding your breath or bouncing."
      }
    ],
