  "definition": {
    "name": {
      "zh": "半跪髋前侧拉伸",
      "en": "Half-Kneeling Hip Stretch"
    },
    "purpose": {
      "zh": "拉伸髋部前面，缓解久坐发紧",
      "en": "Stretch the front of your hip to ease tightness from sitting."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "夹紧臀部，身体慢慢往前推",
          "en": "Squeeze your glute and slowly shift your body forward"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "后膝跪地，前脚踩地，上身直立。",
          "en": "Kneel on the back knee, front foot planted, upper body tall."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "保持不动，慢慢呼吸，每次呼气再放松一点。",
          "en": "Stay still, breathe slowly, and relax a little deeper each time you breathe out."
        }
      },
      {
        "id": "cue4",
        "primary": false,
        "text": {
          "zh": "别来回颠，有拉伸感就够，别拉到疼。",
          "en": "Do not bounce; a clear stretch is enough, never pain."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "靠拱腰往前，而不是收臀",
        "en": "Arching your lower back instead of squeezing your glute."
      },
      {
        "zh": "憋气或来回颠",
        "en": "Holding your breath or bouncing."
      }
    ],
    "tags": {
      "category": "stretch",
      "activeMuscles": [
        "hip-flexors"
      ],
      "synergistMuscles": [
        "quadriceps",
        "glutes"
      ],
