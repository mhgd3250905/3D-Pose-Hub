      "restSeconds": 15
    },
    "cautions": [
      {
        "zh": "跪地的膝盖下面垫软垫",
        "en": "Pad under the kneeling knee."
      },
      {
        "zh": "髋前侧疼时幅度小一点，还疼就停",
        "en": "If your hip hurts, move less far, and stop if it still hurts."
