  "definition": {
    "name": {
      "zh": "扶椅渐进前后劈叉",
      "en": "Chair-Supported Progressive Front Split"
    },
    "purpose": {
      "zh": "一点点拉开大腿后侧和髋前侧",
      "en": "Gradually stretch the backs of your thighs and the front of your hips."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "一手轻扶椅子，前后腿慢慢滑开",
          "en": "Hold the chair lightly and slowly slide your legs apart"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "只滑到能控制的地方，髋部朝前。",
          "en": "Slide only as far as you can control, hips facing forward."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "停住不动，慢慢呼吸。",
          "en": "Stay still and breathe slowly."
        }
      },
      {
        "id": "cue4",
        "primary": false,
        "text": {
          "zh": "每次呼气再放松一点，别来回颠。",
          "en": "Each time you breathe out, relax a little deeper. No bouncing."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "一下子滑得太远",
        "en": "Sliding too far too fast."
      },
      {
        "zh": "憋气",
        "en": "Holding your breath."
      },
      {
        "zh": "来回颠着往下压",
        "en": "Bouncing to go deeper."
      }
    ],
