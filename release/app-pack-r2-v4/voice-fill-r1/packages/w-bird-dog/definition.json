        "primary": true,
        "text": {
          "zh": "一只手和另一侧的腿伸远，身体不晃",
          "en": "Reach one arm and the other leg long while your body stays still"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "跪撑，手在肩膀下面，膝盖在髋下面。",
          "en": "Start on hands and knees, hands under shoulders, knees under hips."
