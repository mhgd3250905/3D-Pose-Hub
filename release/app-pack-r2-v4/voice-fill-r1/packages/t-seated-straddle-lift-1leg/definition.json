  "definition": {
    "name": {
      "zh": "分腿坐单腿抬起",
      "en": "Seated Straddle Single-Leg Lift"
    },
    "purpose": {
      "zh": "分腿坐，练大腿前侧把伸直的腿抬起来",
      "en": "Train the front of your thigh to lift a straight leg in a wide straddle."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "腿伸直，一条腿抬离地面",
          "en": "Keep the leg straight and lift it off the floor"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "分腿坐直，指尖在要抬那条腿的两边点地。",
          "en": "Sit tall in a wide straddle with your fingertips on the floor either side of the lifting leg."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "腿放下停稳后，手抬起转到另一边再撑地。",
          "en": "Once the leg is down, lift your hands, turn to the other side and place them again."
        }
      },
      {
        "id": "cue4",
        "primary": false,
        "text": {
          "zh": "两边各做一次算 1 次。",
          "en": "One on each side counts as one rep."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "身体往后仰去抬腿",
        "en": "Leaning back to lift the leg."
      },
      {
        "zh": "膝盖弯曲",
        "en": "Bending the knee."
      }
    ],
