  "definition": {
    "name": {
      "zh": "跪姿穿针",
      "en": "Kneeling Thread the Needle"
    },
    "purpose": {
      "zh": "让上背转动更灵活，放松肩膀",
      "en": "Loosen up your upper back and relax your shoulders."
    },
    "cues": [
      {
        "id": "cue1",
        "primary": true,
        "text": {
          "zh": "一只手掌心朝上，从另一只手臂下面穿过去",
          "en": "Slide one hand palm-up under your other arm"
        }
      },
      {
        "id": "cue2",
        "primary": false,
        "text": {
          "zh": "穿过去的肩膀往下沉，上背跟着转。",
          "en": "Let that shoulder sink as your upper back turns."
        }
      },
      {
        "id": "cue3",
        "primary": false,
        "text": {
          "zh": "屁股留在膝盖正上方不动。",
          "en": "Keep your hips over your knees."
        }
      }
    ],
    "commonErrors": [
      {
        "zh": "屁股往一边歪",
        "en": "Shifting the hips to one side."
      },
      {
        "zh": "只扭腰不转上背",
        "en": "Twisting the lower back instead of the upper back."
      }
    ],
