  "groups": {
    "deltoids": {
      "label": "三角肌",
      "section": "support",
      "colour": "#4cc9f0",
      "role": "前、中、后束协同控制承重肩，接住每一次换手。"
    },
    "rotator-cuff": {
      "label": "肩袖肌群",
      "section": "support",
      "colour": "#a29bfe",
      "role": "位于深层，帮助稳定肱骨头，支撑方向不断变化时护住肩关节。"
    },
    "triceps": {
      "label": "肱三头肌",
      "section": "support",
      "colour": "#2f6bff",
      "role": "伸肘锁住支撑臂，手臂保持伸直受控。"
    },
    "forearms": {
      "label": "前臂 · 腕屈伸肌",
      "section": "support",
      "colour": "#9ad1e8",
      "role": "掌根撑地时控制手腕与手指，平稳落手、卸载。"
    },
    "serratus": {
      "label": "前锯肌",
      "section": "support",
      "colour": "#5eead4",
      "role": "让肩胛贴着胸廓前伸，主动把地面推远。"
    },
    "scapular": {
      "label": "斜方肌中下部 · 菱形肌",
      "section": "support",
      "colour": "#86efc4",
      "role": "协同调整肩胛位置，维持肩带与地面之间的支撑空间。"
    },
    "chest": {
      "label": "胸大肌",
      "section": "support",
      "colour": "#6f8dff",
      "role": "前撑转侧撑时，配合控制上臂相对胸廓的方向。"
    },
    "lats": {
      "label": "背阔肌",
      "section": "support",
      "colour": "#00a896",
      "role": "连接上臂与躯干，参与肩部下压与身体随支撑转移。"
    },
    "abs": {
      "label": "腹直肌（含深层腹横肌）",
      "section": "core",
      "colour": "#c466ff",
      "role": "卷腹折叠躯干，与深层腹横肌一起稳住骨盆，给抬腿留出空间。"
    },
    "obliques": {
      "label": "腹斜肌",
      "section": "core",
      "colour": "#ff6fb5",
      "role": "参与躯干旋转与侧向控制，让肩与骨盆随摆腿转动。"
    },
    "erectors": {
      "label": "竖脊肌",
      "section": "core",
      "colour": "#e3b3ff",
      "role": "控制脊柱伸展与躯干位置，后撑时帮助保持髋高。"
    },
    "hip-flexors": {
      "label": "髋屈肌",
      "section": "core",
      "colour": "#ff9ec7",
      "role": "位于骨盆深处，主动屈髋，把长腿从身体前方抬过去。"
    },
    "glute-max": {
      "label": "臀大肌",
      "section": "legs",
      "colour": "#ffb703",
      "role": "髋伸展与后方扫腿（深层髋旋转肌配合调整腿的方向）。"
    },
    "hip-abductors": {
      "label": "臀中肌 · 髋外展",
      "section": "legs",
      "colour": "#ff7b2e",
      "role": "主动开腿并控制骨盆，离地后双腿不合拢。"
    },
    "adductors": {
      "label": "内收肌群",
      "section": "legs",
      "colour": "#b5e655",
      "role": "控制腿向中线回收与开度变化，衔接下一段扫腿。"
    },
    "quadriceps": {
      "label": "股四头肌",
      "section": "legs",
      "colour": "#ffe45c",
      "role": "保持膝部伸直，让长腿连续绕行。"
    },
    "hamstrings": {
      "label": "腘绳肌",
      "section": "legs",
      "colour": "#e9a46a",
      "role": "后侧长腿线条，参与髋伸与膝部控制。"
    }
  },
