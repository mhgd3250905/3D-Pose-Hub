  "definition": {
    "idMappings": [],
    "name": {
      "zh": "单腿臀桥",
      "en": "Single-Leg Glute Bridge"
    },
    "purpose": {
      "zh": "单腿臀桥，练臀大肌伸髋（每侧）",
      "en": "Practice a single-leg hip bridge with a level pelvis."
    },
    "tags": {
      "category": "strength",
      "activeMuscles": [
        "glute-max"
      ],
      "synergistMuscles": [
        "hamstrings",
