    "contraindications": {
      "items": [
        {
          "zh": "本动作引发疼痛时停止，不通过增加幅度或负重继续；先向医生或物理治疗师确认。",
          "en": "Stop if this exercise causes pain; do not add range or load before seeking clinical advice."
        },
        {
          "zh": "已有医嘱限制屈膝坐姿、髋外展外旋或躯干前屈时，先取得许可。",
          "en": "Obtain clearance first if bent-knee sitting, hip abduction or external rotation, or forward bending has been restricted."
        }
      ],
