  "definition": {
    "idMappings": [],
    "name": {
      "zh": "蝴蝶式",
      "en": "Seated Butterfly Stretch"
    },
    "purpose": {
      "zh": "脚心相对坐姿缓慢前倾，拉伸大腿内侧",
      "en": "Hinge forwards gently in a soles-together sitting position to stretch the inner thighs."
    },
    "tags": {
      "category": "stretch",
      "activeMuscles": [
        "adductors"
      ],
      "synergistMuscles": [
        "erectors"
      ],
      "equipment": [
        "mat"
      ],
      "position": "seated",
      "scenes": [
        "home"
      ],
      "difficulty": 1,
      "trainingType": "stretch"
    },
    "unilateral": false,
    "startingSide": null,
    "cues": [
      {
        "id": "cue1",
        "text": {
          "zh": "脚心相对，双手轻扶小腿，从髋部缓慢前倾",
          "en": "Keep the soles together, rest your hands lightly on your shins and hinge forwards slowly from the hips"
        },
        "primary": true
      },
      {
        "id": "cue2",
        "text": {
          "zh": "坐稳，双膝自然向两侧打开，不用手向下压",
          "en": "Sit steadily with the knees naturally open to the sides, without pressing them down by hand."
        },
        "primary": false
      },
      {
        "id": "cue3",
        "text": {
          "zh": "背部保持舒展，在舒适幅度内前倾",
          "en": "Keep the back long and hinge only through a comfortable range."
        },
        "primary": false
      },
      {
        "id": "cue4",
        "text": {
          "zh": "继续自然呼吸，再缓慢回到较直立的位置",
          "en": "Keep breathing naturally and return slowly to the more upright position."
        },
        "primary": false
      }
    ],
    "commonErrors": [
      {
        "zh": "压膝盖、弹振或把膝盖碰地当作必须目标",
        "en": "Pressing or bouncing the knees or insisting they touch the floor."
      },
      {
        "zh": "含胸猛拉脚踝，或为加深幅度而憋气",
        "en": "Pulling hard on the ankles with a rounded chest or holding the breath to force more depth."
      }
    ],
    "cautions": {
      "items": [
        {
          "zh": "大腿内侧与腹股沟：采用温和拉伸，不硬压到痛。",
          "en": "Inner thighs and groin: use a gentle stretch without forcing a painful range."
        },
        {
          "zh": "膝与腰背：膝盖随髋自然打开，前倾来自髋部，不用手压膝。",
          "en": "Knees and lower back: let the knees open from the hips and hinge from the hips without pressing the knees down."
        }
      ],
      "review": {
        "status": "pending",
