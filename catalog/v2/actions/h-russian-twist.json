    "idMappings": [],
    "name": {
      "zh": "俄罗斯转体",
      "en": "Russian Twist (Feet Down)"
    },
    "purpose": {
      "zh": "练腰两侧",
      "en": "Train controlled alternating trunk rotation with the feet supported."
    },
    "tags": {
      "category": "core",
      "activeMuscles": [
        "obliques"
      ],
      "synergistMuscles": [
        "abs",
        "hip-flexors"
      ],
