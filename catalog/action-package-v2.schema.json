{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pose-hub.invalid/catalog/action-package-v2.schema.json",
  "title": "Action package v2 authoring schema",
  "description": "New production contract replacing drill-pack@1, action-kit@1 and flarelab-drill-media@1. Drafts may omit incomplete fields; release eligibility MUST be computed by tools/action_package_v2.py --release. Schema validation alone never approves release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "version",
    "status",
    "definition",
    "source",
    "masters",
    "derivatives",
    "voice",
    "validation"
  ],
  "properties": {
    "format": {
      "const": "action-package@2"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "ready",
        "published"
      ]
    },
    "definition": {
      "$ref": "#/$defs/definition"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "masters": {
      "$ref": "#/$defs/masters"
    },
    "derivatives": {
      "$ref": "#/$defs/derivatives"
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelVersion": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ref"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "mirrorGenerated": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ref": {
      "type": "object",
      "description": "Path is relative POSIX under a caller-bound root, never an absolute local path. bytes is the exact stored length; source text may request LF hash normalization.",
      "required": [
        "root",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "root": {
          "enum": [
            "repo",
            "media"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:\\\\|:|(?:^|/)\\.\\.(?:/|$))).+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "normalization": {
          "const": "lf"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frameCount": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pixelFormat": {
          "type": "string"
        },
        "codec": {
          "type": "string"
        },
        "alpha": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "framesReviewed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          }
        },
        "notes": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "reviewedItems": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bi"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "oldId",
              "newId"
            ],
            "additionalProperties": false,
            "properties": {
              "oldId": {
                "type": "string"
              },
              "newId": {
                "type": "string"
              }
            }
          }
        },
        "name": {
          "$ref": "#/$defs/bi"
        },
        "purpose": {
          "$ref": "#/$defs/bi"
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": {
              "enum": [
                "strength",
                "core",
                "cardio",
                "mobility",
                "stretch"
              ]
            },
            "activeMuscles": {
              "$ref": "#/$defs/strings"
            },
            "synergistMuscles": {
              "$ref": "#/$defs/strings"
            },
            "equipment": {
              "$ref": "#/$defs/strings"
            },
            "position": {
              "type": "string"
            },
            "scenes": {
              "$ref": "#/$defs/strings"
            },
            "difficulty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "trainingType": {
              "enum": [
                "strength",
                "stretch",
                "control"
              ]
            }
          }
        },
        "unilateral": {
          "type": "boolean",
          "description": "One side supplies the primary effort in a movement; not a per-side dose multiplier. Includes alternating unilateral demonstrations."
        },
        "startingSide": {
          "enum": [
            "left",
            "right",
            null
          ]
        },
        "countingSemantics": {
          "type": "string",
          "minLength": 1
        },
        "movementSides": {
          "type": "string",
          "minLength": 1
        },
        "cues": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "primary"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "$ref": "#/$defs/bi"
              },
              "primary": {
                "type": "boolean"
              }
            }
          }
        },
        "commonErrors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/bi"
          }
        },
        "cautions": {
          "$ref": "#/$defs/reviewedItems"
        },
        "contraindications": {
          "$ref": "#/$defs/reviewedItems"
        },
        "alternatives": {
          "$ref": "#/$defs/strings"
        },
        "regressions": {
          "$ref": "#/$defs/strings"
        },
        "progressions": {
          "$ref": "#/$defs/strings"
        },
        "defaultDose": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "time",
                "reps"
              ]
            },
            "sets": {
              "type": "integer",
              "minimum": 1
            },
            "reps": {
              "type": "integer",
              "minimum": 1
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "restSeconds": {
              "type": "number",
              "minimum": 0
            },
            "holdSeconds": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "doseRange": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "rhythm": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "rep_updown",
                "rep_cycle",
                "rep_alternate",
                "rep_hold",
                "rep_breath",
                "hold",
                "self_paced"
              ]
            },
            "leadSeconds": {
              "type": "number",
              "minimum": 0
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "seconds"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "cue": {
                    "type": "string"
                  },
                  "cueAt": {
                    "type": "number"
                  }
                }
              }
            },
            "holdSeconds": {
              "type": "number"
            },
            "reps": {
              "type": "integer"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "apps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "hiplab",
              "flarelab",
              "smartfit"
            ]
          }
        },
        "editorialReview": {
          "$ref": "#/$defs/review"
        },
        "editorialNotes": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "training-human-v2plus"
            },
            "version": {
              "type": "string"
            },
            "manifest": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "spec": {
          "$ref": "#/$defs/ref"
        },
        "highlightMuscles": {
          "$ref": "#/$defs/strings"
        },
        "demonstratedSide": {
          "enum": [
            "left",
            "right",
            "both"
          ]
        },
        "oppositeSideMedia": {
          "const": "not-produced"
        },
        "keyMoments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            },
            "peak": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            },
            "end": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            },
            "switchPoint": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "in-clip",
                    "loop-boundary"
                  ]
                },
                "seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 8
                },
                "semantics": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intersections": {
              "$ref": "#/$defs/review"
            },
            "handsFeet": {
              "$ref": "#/$defs/review"
            },
            "propFlicker": {
              "$ref": "#/$defs/review"
            },
            "loopSeam": {
              "$ref": "#/$defs/review"
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "layer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "sharedFrom"
          ],
          "additionalProperties": false,
          "properties": {
            "sharedFrom": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sequence": {
              "$ref": "#/$defs/ref"
            },
            "width": {
              "const": 1080
            },
            "height": {
              "const": 1080
            },
            "frameCount": {
              "const": 240
            },
            "fps": {
              "const": 30
            },
            "durationSeconds": {
              "const": 8
            },
            "alpha": {
              "const": true
            },
            "grayscale": {
              "const": true
            },
            "occlusionAware": {
              "const": true
            }
          }
        }
      ]
    },
    "masters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredSkins": {
          "$ref": "#/$defs/strings"
        },
        "skins": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "geometrySha256": {
                "$ref": "#/$defs/sha"
              },
              "occlusionSha256": {
                "$ref": "#/$defs/sha"
              },
              "measurement": {
                "$ref": "#/$defs/ref"
              },
              "bodyProps": {
                "$ref": "#/$defs/layer"
              },
              "highlightMask": {
                "$ref": "#/$defs/layer"
              },
              "shadow": {
                "$ref": "#/$defs/layer"
              }
            }
          }
        },
        "loopReview": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "derivatives": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "composite-from-masters"
        },
        "mirrored": {
          "const": false
        },
        "compositor": {
          "$ref": "#/$defs/ref"
        },
        "framingId": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "framing": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "skin": {
                "type": "string"
              },
              "theme": {
                "enum": [
                  "light",
                  "dark"
                ]
              },
              "modelVersion": {
                "type": "string"
              },
              "highlight": {
                "type": "object",
                "required": [
                  "enabled",
                  "color",
                  "brightness"
                ],
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "brightness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              },
              "video": {
                "$ref": "#/$defs/ref"
              },
              "cover": {
                "$ref": "#/$defs/ref"
              },
              "thumbnail": {
                "$ref": "#/$defs/ref"
              },
              "keyframes": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "phase",
                    "asset"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "phase": {
                      "enum": [
                        "start",
                        "peak",
                        "end"
                      ]
                    },
                    "asset": {
                      "$ref": "#/$defs/ref"
                    }
                  }
                }
              },
              "mirrored": {
                "const": false
              }
            }
          }
        },
        "transparentCovers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    }
  }
}
