  "en": "Planche Lean Hold"
 },
 "purpose": {
  "zh": "直臂撑地、肩膀前移过手腕并停住，练肩前侧和手腕的承重，为 Flare 和俄挺打底",
  "en": "Straight-arm support with the shoulders moved forward past the wrists, held still. Loads the front of the shoulders and the wrists, a base for flares and planche work."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "锁肘，肩膀前移过手腕，身体一条线",
    "en": "Elbows locked, shoulders past wrists, one line"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "手指朝外 45 到 90 度，绝不朝后。",
    "en": "Fingers turned out 45 to 90 degrees, never pointing back."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "肩胛往前推开、往下压，背微微拱起。",
    "en": "Push the shoulder blades apart and down, upper back slightly rounded."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "脚尖撑地，臀部和腿夹紧，不塌腰。",
    "en": "On your toes, glutes and legs tight, no sagging."
   }
  }
 ],
 "commonErrors": [
