  "zh": "扶椅站姿大腿前侧拉伸",
  "en": "Chair-Supported Standing Quad Stretch"
 },
 "purpose": {
  "zh": "拉开大腿前面",
  "en": "Stretches the front of your thigh."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "手抓脚踝，把脚后跟往屁股拉",
    "en": "Hold your ankle and pull your heel toward your butt"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "单腿站直扶椅，两个膝盖并排。",
    "en": "Stand tall on one leg holding the chair, knees side by side."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
