  "zh": "拉开肩膀前面和胸口",
  "en": "Stretches the fronts of your shoulders and your chest."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "手臂伸直，把毛巾往上往后抬离后背",
    "en": "Arms straight, lift the towel up and away from your back"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两手在背后拉紧毛巾，比胯宽一点。",
    "en": "Hold the towel tight behind you, hands a bit wider than your hips."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "挺胸，上身别往前倒，抬到顶停一下再放下。",
    "en": "Chest up, don't lean forward. Pause at the top, then lower."
   }
  }
 ],
