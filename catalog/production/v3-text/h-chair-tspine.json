   "primary": true,
   "text": {
    "zh": "屁股在膝盖正上方，胸口在两臂中间往下沉",
    "en": "Hips over knees, let your chest sink between your arms"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两手平放在椅面上，手臂伸直。",
    "en": "Hands flat on the seat, arms straight."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "腰别往下塌，停住喘口气，再抬回平背。",
    "en": "Don't let your lower back sag. Hold, breathe, then lift back to a flat back."
   }
  }
 ],
