  "zh": "练小腿深层肌肉，提升踝部力量",
  "en": "Build the deeper calf muscles and ankle strength."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "膝盖保持弯曲，用前脚掌把脚跟抬起",
    "en": "Keep your knees bent and rise onto the balls of your feet"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "双手放在髋上，身体保持挺直",
    "en": "Rest your hands on your hips and stay tall."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "慢慢放下脚跟，膝盖角度不变",
    "en": "Lower your heels slowly without changing your knee bend."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "提踵时膝盖伸直",
   "en": "Straightening the knees as you rise."
  },
  {
   "zh": "重心向外脚踝倒",
   "en": "Rolling onto the outer edges of the feet."
  }
 ],
 "cautions": [
  {
   "zh": "脚踝或跟腱不适时减小幅度，仍痛就停止",
