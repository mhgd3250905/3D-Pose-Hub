  "zh": "拉伸胸部和肩前侧",
  "en": "Stretch the chest and the front of the shoulders."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "双手撑在身后不动，臀部慢慢向前滑",
    "en": "Keep your hands planted behind you and slowly slide your hips forward"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "手指朝后，胸口保持抬起",
