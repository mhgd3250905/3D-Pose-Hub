 "name": {
  "zh": "坐姿后撑滑臀",
  "en": "Seated Reach-Back Shoulder Stretch"
 },
 "purpose": {
  "zh": "拉开胸口和肩膀前面",
  "en": "Stretches your chest and the fronts of your shoulders."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "两手撑在身后不动，屁股慢慢往前挪",
    "en": "Hands planted behind you, slowly scoot your butt forward"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "手指朝后，手臂伸直，胸口往上挺。",
    "en": "Fingers point back, arms straight, chest up."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气。",
    "en": "Stay right there and breathe slowly."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "每次呼气再松一点，别一下一下往下压。",
    "en": "Each breath out, let go a little more. Don't bounce."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "耸肩",
   "en": "Shrugging your shoulders."
  },
  {
   "zh": "憋气",
   "en": "Holding your breath."
  },
  {
   "zh": "一下一下往下压",
   "en": "Bouncing to go deeper."
  }
 ],
 "cautions": [
  {
   "zh": "拉到舒服就行，疼就松一点",
   "en": "Stretch only to a comfortable point. Ease off if anything hurts."
  },
  {
   "zh": "手腕刺疼或发麻就停，开始前先转转手腕",
   "en": "Stop if your wrists get sharp pain or go numb. Roll them out before you start."
  }
 ],
