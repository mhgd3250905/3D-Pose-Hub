 "name": {
  "zh": "靠墙单臂胸肌拉伸",
  "en": "Single-Arm Wall Pec Stretch"
 },
 "purpose": {
  "zh": "拉开胸口、肩膀前面和大臂前面",
  "en": "Stretches your chest, the front of your shoulder and the front of your upper arm."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "手掌贴墙不动，身子慢慢转开",
    "en": "Palm stays on the wall, slowly turn your body away"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "手臂往后贴墙，跟肩膀一样高，肩膀往下放。",
    "en": "Arm back along the wall at shoulder height, shoulder down."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "手掌钉在墙上，转到胸口前面有拉的感觉就停。",
    "en": "Palm pinned to the wall. Stop turning when the front of your chest stretches."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "呼气时脚往外挪半步，身子跟着再转开一点。",
    "en": "Each breath out, shuffle your feet a little and turn a bit further."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "耸肩",
   "en": "Shrugging your shoulder."
  },
  {
   "zh": "憋气",
   "en": "Holding your breath."
  },
  {
   "zh": "肩膀往前耸，拉到的是肩不是胸",
   "en": "Shoulder rolling forward, so you stretch the shoulder, not the chest."
  }
 ],
 "cautions": [
  {
   "zh": "手发麻或肩膀前面刺疼，就把手放低一点",
   "en": "If your hand tingles or the front of your shoulder hurts sharply, lower your hand."
  }
 ],
