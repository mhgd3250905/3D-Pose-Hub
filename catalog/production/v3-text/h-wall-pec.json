 "name": {
  "zh": "靠墙单臂胸肌拉伸",
  "en": "Single-Arm Wall Pec Stretch"
 },
 "purpose": {
  "zh": "拉伸胸部、肩前侧和二头肌",
  "en": "Stretch your chest, front shoulder and biceps."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "手掌贴墙不动，身体慢慢转离墙面",
    "en": "Keep your palm on the wall and slowly turn your body away"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "手臂向后贴墙，与肩同高，肘微屈",
    "en": "Reach your arm back along the wall at shoulder height, elbow soft."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "肩膀下沉，肋骨不外翻，停住呼吸",
    "en": "Keep your shoulder down and ribs in, then hold and breathe."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "耸肩",
   "en": "Shrugging."
  },
  {
   "zh": "转得太猛",
   "en": "Turning too far too fast."
  }
 ],
 "cautions": [
  {
   "zh": "肩部疼痛时减小幅度，仍痛就停止",
   "en": "Reduce the range if your shoulders hurt, and stop if the pain continues."
  }
 ],
