 "name": {
  "zh": "跪姿穿针",
  "en": "Kneeling Thread the Needle"
 },
 "purpose": {
  "zh": "让上背转得更开，放松肩膀",
  "en": "Loosens up your upper back so it turns more, and relaxes your shoulders."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "一只手手心朝上，从另一只胳膊底下穿过去",
    "en": "Slide one hand palm-up under your other arm"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "穿过去那边的肩膀往下沉，上背跟着转。",
    "en": "Let that shoulder sink as your upper back turns."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "屁股一直在膝盖正上方，别动。",
    "en": "Hips stay right over your knees."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "手往里穿的时候屁股跟着往外跑",
   "en": "Hips drifting out as you thread your arm through."
  },
  {
   "zh": "只扭腰，上背没转",
   "en": "Twisting your lower back instead of your upper back."
  }
 ],
 "cautions": [
  {
   "zh": "肩膀压在地上不舒服就少穿一点",
   "en": "If your shoulder on the floor feels off, don't thread as far."
  },
  {
   "zh": "撑地那只手腕不舒服就换小臂撑",
   "en": "If your support wrist complains, drop onto that forearm."
  }
 ],
