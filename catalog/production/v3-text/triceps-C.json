  "zh": "双杠臂屈伸",
  "en": "Parallel Bar Dips"
 },
 "purpose": {
  "zh": "练大臂后面和胸，从低处把身子推起来",
  "en": "Builds the backs of your upper arms and your chest by pressing up from low down."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "下到大臂差不多跟地面平，再推起来",
    "en": "Lower until your upper arms are about level, then press up"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "推到顶手肘伸直、肩膀往下压，停一下。",
    "en": "At the top, straighten your elbows, press your shoulders down and pause."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "膝盖弯着，腿别甩。",
    "en": "Knees bent. Don't swing your legs."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "下太深，肩膀往前塌",
   "en": "Going too deep so your shoulders roll forward."
  },
  {
   "zh": "甩腿借劲",
   "en": "Swinging your legs for momentum."
  }
 ],
 "cautions": [
  {
   "zh": "肩膀不舒服就先只在顶上撑住，再一点点往下",
   "en": "If your shoulders feel off, start with holds at the top, then go a little deeper over time."
  },
  {
   "zh": "做不满就脚踩地帮一把",
   "en": "Can't get them all? Let your feet help from the floor."
  }
 ],
