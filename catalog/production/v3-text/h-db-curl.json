 "name": {
  "zh": "哑铃交替弯举",
  "en": "Alternating Dumbbell Curl"
 },
 "purpose": {
  "zh": "练大臂前面",
  "en": "Builds the fronts of your upper arms."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "大臂贴住身体，只动小臂",
    "en": "Upper arms stay at your sides, only your forearms move"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两只手轮流弯，往上时手心慢慢转朝上。",
    "en": "Take turns with each arm, turning your palm up as you curl."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "放下来慢一点，身子别晃。",
    "en": "Lower slowly and keep your body still."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "两边各弯一次算 1 下。",
    "en": "One curl on each side counts as one."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "身子前后晃，把哑铃甩起来",
   "en": "Rocking your body to swing the weight up."
  },
  {
   "zh": "弯的时候手肘往前跑",
   "en": "Elbow drifting forward as you curl."
  }
 ],
 "cautions": [
  {
   "zh": "选个不用甩就能弯起来的重量，手肘或手腕疼就停",
   "en": "Pick a weight you can curl without swinging. Stop if your elbow or wrist hurts."
  }
 ],
