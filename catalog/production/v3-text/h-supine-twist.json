  "en": "Lying Knee-Drop Twist"
 },
 "purpose": {
  "zh": "放松腰，拉开身子两边",
  "en": "Relaxes your lower back and stretches the sides of your body."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "两膝慢慢倒向一边，两边肩膀贴住垫子",
    "en": "Slowly drop both knees to one side, both shoulders on the mat"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两臂摆成 T 字放在垫子上。",
    "en": "Arms out in a T on the mat."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "两边肩膀都贴着垫子，膝盖倒到哪儿算哪儿。",
    "en": "Both shoulders stay on the mat. Let your knees go only as far as they go."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "呼气时让膝盖自己再往下沉一点，别用手推。",
    "en": "Each breath out, let your knees sink a bit more on their own. Don't push them."
   }
  }
 ],
