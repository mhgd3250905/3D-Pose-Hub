 "name": {
  "zh": "椅子反撑",
  "en": "Chair Dip"
 },
 "purpose": {
  "zh": "练大臂后面和胸",
  "en": "Builds the backs of your arms and your chest."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "手肘直直往后弯，肩膀别耸",
    "en": "Bend your elbows straight back, shoulders down"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两手撑在椅面前沿，膝盖弯着，两脚踩地。",
    "en": "Hands on the front edge of the seat, knees bent, feet flat."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "下到大臂差不多跟地面平，再撑回手臂伸直。",
    "en": "Lower until your upper arms are about level, then push back up to straight arms."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "手肘往两边张开",
   "en": "Elbows flaring out."
  },
  {
   "zh": "耸肩，或肩膀往前塌",
   "en": "Shrugging or shoulders rolling forward."
  }
 ],
 "cautions": [
  {
   "zh": "肩膀前面夹着疼就下浅点；做不满就把脚往回收一点",
   "en": "If the front of your shoulder pinches, don't go as low. Can't get them all? Walk your feet in closer."
  },
  {
   "zh": "用结实、不带轮子的椅子",
   "en": "Use a sturdy chair without wheels."
  }
 ],
