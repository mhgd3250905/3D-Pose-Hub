   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "屁股猛地往前一顶，让壶铃自己荡起来",
    "en": "Snap your hips forward and let the bell float up"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "背挺平，屁股往后坐，壶铃荡到两腿中间。",
    "en": "Flat back, push your hips back as the bell swings between your legs."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "顶上站直、夹紧屁股，人别往后仰。",
    "en": "Stand tall at the top, squeeze your butt, don't lean back."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "用手臂把壶铃抬起来",
   "en": "Lifting the bell with your arm."
  },
  {
   "zh": "蹲下去，不是屁股往后坐",
   "en": "Squatting instead of pushing your hips back."
  },
  {
   "zh": "弓背",
   "en": "Rounding your back."
  }
 ],
 "cautions": [
  {
   "zh": "腰疼就停；先两手抱一个轻壶铃练熟再单手",
