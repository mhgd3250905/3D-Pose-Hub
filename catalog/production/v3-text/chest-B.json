 "name": {
  "zh": "平行杆深幅俯卧撑",
  "en": "Deep Parallette Push-Up"
 },
 "purpose": {
  "zh": "练胸和手臂，比普通俯卧撑下得更深",
  "en": "Builds your chest and arms with a push-up that goes deeper than usual."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "胸口沉到两手中间，手肘斜着往后",
    "en": "Sink your chest between your hands, elbows angled back"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "推到顶手臂伸直，再把地往下推远一点。",
    "en": "At the top, straighten your arms and push the floor a bit further away."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "从头到脚跟像一块板，别塌腰。",
    "en": "Head to heels like one plank, no sagging."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "下得太猛，肩膀往前顶",
   "en": "Dropping so deep the shoulders roll forward."
  },
  {
   "zh": "腰塌下去",
   "en": "Hips sagging."
  }
 ],
 "cautions": [
  {
   "zh": "肩膀前面夹着疼就下浅点；做不满 8 个就跪着做",
   "en": "If the front of your shoulder pinches, don't go as deep. Can't get 8? Do them on your knees."
  },
  {
   "zh": "手腕疼或发麻就停",
   "en": "Stop if your wrists hurt or go numb."
  }
 ],
