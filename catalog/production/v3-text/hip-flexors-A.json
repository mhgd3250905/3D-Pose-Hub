 "name": {
  "zh": "坐姿直腿抬腿",
  "en": "Seated Pike Leg Lifts"
 },
 "purpose": {
  "zh": "上身前倾时把腿抬起来，练大腿根前面的劲",
  "en": "Lifting your legs while leaning forward builds the tops of your thighs."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "上身往前倾，两腿伸直抬离地面几厘米",
    "en": "Lean forward and lift both straight legs a few centimetres off the floor"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "坐在地上腿伸直并拢，两手撑在膝盖两边。",
    "en": "Sit with your legs straight together, hands beside your knees."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "抬起来停住，再慢慢放下。",
    "en": "Hold the lift, then lower slowly."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "上身往后仰去抬腿",
   "en": "Leaning back to lift your legs."
  },
  {
   "zh": "膝盖弯了",
   "en": "Bending your knees."
  }
 ],
 "cautions": [
  {
   "zh": "大腿前面抽筋或胯疼就停下歇会儿；抬不起来就一次只抬一条腿",
   "en": "Stop and rest if the front of your thigh cramps or your hip hurts. Can't lift both? Do one leg at a time."
  }
 ],
