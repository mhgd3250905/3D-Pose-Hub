 "name": {
  "zh": "仰卧4字臀部拉伸",
  "en": "Lying Figure-4 Stretch"
 },
 "purpose": {
  "zh": "拉开屁股深处，胯发紧时松一松",
  "en": "Stretches deep in your butt to ease tight hips."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "脚踝搭在另一条腿的大腿上，膝盖往外打开",
    "en": "Cross your ankle over your other thigh and let that knee fall open"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "仰躺，踩地的脚往屁股挪一点，头和肩膀放松。",
    "en": "Lie on your back, walk the planted foot in a bit, head and shoulders relaxed."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "抬头耸肩使劲",
   "en": "Lifting your head and tensing your shoulders."
  },
  {
   "zh": "使劲压膝盖",
   "en": "Pushing the knee down hard."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "膝盖疼就松一点，还疼就停",
   "en": "If your knee hurts, ease off. Stop if it still hurts."
  }
 ],
