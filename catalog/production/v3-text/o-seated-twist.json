 "name": {
  "zh": "坐姿扶椅扭转",
  "en": "Seated Chair Twist"
 },
 "purpose": {
  "zh": "转转上背和腰，久坐僵了松一松",
  "en": "Turns your upper back and waist to ease stiffness from sitting."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "坐直，身子转向一边，手扶椅背",
    "en": "Sit tall, turn to one side and hold the backrest"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "另一只手扶在转过去那边的膝盖外面。",
    "en": "Other hand on the outside of the knee on the side you turn to."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "弓着背扭",
   "en": "Twisting with a slumped back."
  },
  {
   "zh": "用手猛拉往深转",
   "en": "Yanking with your hands to go further."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "腰背疼就转少点，还疼就停",
   "en": "If your back hurts, don't turn as far. Stop if it still hurts."
  }
 ],
