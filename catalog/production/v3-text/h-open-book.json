{
 "format": "pose-hub-action-text@1",
 "id": "h-open-book",
 "reviewStatus": "ai-reviewed-r3-needs-user-review",
 "sources": [
  "drill-anim/specs/h-open-book-r8.js"
 ],
 "name": {
  "zh": "侧卧开书式",
  "en": "Side-Lying Open Book"
 },
 "purpose": {
  "zh": "让上背转得更开，拉开胸口和肩膀前面",
  "en": "Loosens up your upper back and stretches your chest and the front of your shoulder."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "两膝并拢，上面的手臂画个大弧往后打开",
    "en": "Knees together, sweep your top arm back in a big arc"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "侧躺头枕垫子，胯和膝盖都弯成直角。",
    "en": "Lie on your side, head on a cushion, hips and knees bent at right angles."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "眼睛跟着手走。",
    "en": "Follow your hand with your eyes."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "膝盖分开，或屁股往后翻",
   "en": "Knees separating or hips rolling back."
  }
 ],
 "cautions": [
  {
   "zh": "肩膀前面夹着疼就打开少点，还疼就停",
   "en": "If the front of your shoulder pinches, don't open as far. Stop if it still hurts."
  }
 ],
 "tags": {
