   "primary": true,
   "text": {
    "zh": "大臂贴着耳朵不动，只用小臂把哑铃举直",
    "en": "Upper arm by your ear, straighten only your forearm"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "哑铃从头后面往上举，举到手臂伸直。",
    "en": "Lift the dumbbell from behind your head until your arm is straight."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "慢慢放回头后面，在底下停一下再举。",
    "en": "Lower it slowly behind your head and pause at the bottom."
   }
  }
 ],
