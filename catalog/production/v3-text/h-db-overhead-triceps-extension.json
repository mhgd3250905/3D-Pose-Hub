  "zh": "练手臂后侧",
  "en": "Build the back of the upper arm."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "大臂竖直贴近耳朵，只弯伸肘关节",
    "en": "Keep your upper arm vertical by your ear and bend only at the elbow"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "哑铃慢慢落到头后，再向上伸直",
    "en": "Lower the dumbbell slowly behind your head, then press it straight up."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "肋骨下沉，腰不后仰",
    "en": "Keep your ribs down and do not arch your back."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "大臂向前或向外移动",
   "en": "Letting the upper arm drift forward or out."
  },
  {
   "zh": "腰往后仰",
   "en": "Arching the lower back."
  }
 ],
 "cautions": [
