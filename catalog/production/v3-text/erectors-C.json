   "text": {
    "zh": "从胯往下弯，背挺平别弓",
    "en": "Fold down from your hips with a flat back"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "垫子顶在胯骨下面，两手交叉抱在胸前。",
    "en": "Pad just below your hip bones, arms crossed on your chest."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "起到身体一条直线就停，别再往后仰。",
    "en": "Come up until you're straight, then stop. Don't lean back further."
   }
  }
 ],
