  "zh": "宽腿L撑",
  "en": "Wide-Leg L-Sit"
 },
 "purpose": {
  "zh": "练撑住身子、把分开的两腿抬离地面的劲",
  "en": "Builds the strength to hold yourself up with your legs wide off the floor."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "两手撑起来，伸直的两腿分开离地",
    "en": "Press up on your hands, straight legs wide off the floor"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "肩膀用力往下压，像要把自己从地上顶起来。",
    "en": "Drive your shoulders down like you are lifting yourself off the floor."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "正常喘气，别憋气。",
    "en": "Breathe normally. Don't hold your breath."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "耸肩",
   "en": "Shrugging."
  },
  {
   "zh": "弯膝盖",
   "en": "Bending your knees."
  }
 ],
 "cautions": [
  {
   "zh": "先把手腕前后转一转，撑着刺疼就落地",
   "en": "Roll your wrists first, and come down if they hurt sharply."
  },
  {
   "zh": "手腕或肩膀疼就少撑几秒，还疼就停；撑不住就脚跟点地做",
   "en": "If your wrists or shoulders hurt, hold for less time. Stop if it still hurts. Can't stay up? Keep your heels touching the floor."
  }
 ],
