 "name": {
  "zh": "扶墙屈膝小腿拉伸",
  "en": "Bent-Knee Wall Calf Stretch"
 },
 "purpose": {
  "zh": "拉开小腿靠下面那段，脚踝更灵活",
  "en": "Stretches the lower part of your calf and loosens your ankle."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "后脚跟踩实，两膝微弯往前往下沉",
    "en": "Back heel down, bend both knees and sink forward"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "小步前后站，两手扶墙。",
    "en": "Short split stance, hands on the wall."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气。",
    "en": "Stay right there and breathe slowly."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "每次呼气再松一点，别一下一下往下压。",
    "en": "Each breath out, let go a little more. Don't bounce."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "后脚跟抬起来",
   "en": "Back heel lifting."
  },
  {
   "zh": "憋气",
   "en": "Holding your breath."
  },
  {
   "zh": "一下一下往下压",
   "en": "Bouncing to go deeper."
  }
 ],
 "cautions": [
  {
   "zh": "地滑就穿防滑鞋，扶稳墙",
   "en": "If the floor is slippery, wear non-slip shoes and hold the wall firmly."
  },
  {
   "zh": "疼就沉少点，还疼就停",
   "en": "If it hurts, don't sink as far. Stop if it still hurts."
  }
 ],
