 "name": {
  "zh": "泡沫轴墙面上滑",
  "en": "Foam Roller Wall Slide"
 },
 "purpose": {
  "zh": "手臂举过头时，让肩胛骨跟着往上转、贴住身子",
  "en": "Trains your shoulder blades to rotate up and stay flat against your ribs as your arms go overhead."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "小臂压住泡沫轴，顺着墙往上滚",
    "en": "Press your forearms into the roller and roll it up the wall"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "面朝墙站直，两小臂平行，手心相对。",
    "en": "Stand tall facing the wall, forearms parallel, palms facing each other."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "滚到最高，肩膀往前送一点，停一下再滑下来。",
    "en": "At the top, reach your shoulders forward a little, pause, then slide down."
   }
  }
 ],
 "commonErrors": [
