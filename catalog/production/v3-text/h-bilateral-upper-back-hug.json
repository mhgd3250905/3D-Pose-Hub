   "primary": true,
   "text": {
    "zh": "两臂往前抱住自己，上背往后拱",
    "en": "Hug yourself and round your upper back"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "肩胛骨往两边分开，低头，脖子放松。",
    "en": "Spread your shoulder blades apart, drop your head, relax your neck."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "别憋气，每次呼气再抱紧一点。",
    "en": "Keep breathing and hug a little tighter each breath out."
   }
  }
 ],
