 "name": {
  "zh": "双臂前抱上背拉伸",
  "en": "Bilateral Upper Back Hug Stretch"
 },
 "purpose": {
  "zh": "拉伸上背和肩胛之间",
  "en": "Stretch the upper back between the shoulder blades."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "双臂向前环抱，上背向后拱起",
    "en": "Wrap your arms forward and round your upper back"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "肩胛向两侧分开，低头放松颈部",
    "en": "Spread your shoulder blades apart and relax your neck."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "保持呼吸，再慢慢松开",
    "en": "Keep breathing, then release slowly."
   }
  }
 ],
 "commonErrors": [
  {
