 "name": {
  "zh": "下犬式压肩",
  "en": "Downward Dog Shoulder Press"
 },
 "purpose": {
  "zh": "把肩膀打开，拉开腋下和胸口",
  "en": "Opens up your shoulders and stretches your armpits and chest."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "手臂伸直，胸口往大腿那边压",
    "en": "Arms straight, press your chest toward your thighs"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "屁股往天上顶，背拉长，脚后跟往地上落。",
    "en": "Hips up high, back long, heels reaching for the floor."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气。",
    "en": "Stay right there and breathe slowly."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "每次呼气再松一点，别一下一下往下压。",
    "en": "Each breath out, let go a little more. Don't bounce."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "弓背",
   "en": "Rounding your back."
  },
  {
   "zh": "耸肩，肩膀挤着脖子",
   "en": "Shrugging up into your neck."
  },
  {
   "zh": "一下一下往下压",
   "en": "Bouncing to go deeper."
  }
 ],
 "cautions": [
  {
   "zh": "拉到舒服就行；腿后面太紧就把膝盖弯一点",
   "en": "Stretch only to a comfortable point. Backs of your legs too tight? Bend your knees a little."
  },
  {
   "zh": "手腕刺疼或发麻就停，开始前先转转手腕",
   "en": "Stop if your wrists get sharp pain or go numb. Roll them out before you start."
  }
 ],
