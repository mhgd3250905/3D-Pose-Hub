  "zh": "练肩膀后面和上背，帮你把含胸驼背的肩膀拉回来",
  "en": "Builds your rear shoulders and upper back to help pull rounded shoulders back."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "上身前倾背挺平，两臂往两边打开到跟背一样平",
    "en": "Lean forward, flat back, open your arms level with your back"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "手肘微弯不变，两块肩胛骨往中间夹。",
    "en": "Elbows stay softly bent. Squeeze your shoulder blades together."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "别耸肩、别甩，慢慢放下来。",
    "en": "No shrugging or swinging. Lower slowly."
   }
  }
 ],
 "commonErrors": [
