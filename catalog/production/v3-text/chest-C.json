 "name": {
  "zh": "绳索单臂站姿推胸",
  "en": "Single-Arm Standing Cable Press"
 },
 "purpose": {
  "zh": "练胸，同时练腰腹别被绳子拽得转身",
  "en": "Builds your chest while your middle fights the cable trying to twist you."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "前后脚站稳，一只手往前推直",
    "en": "Stagger your feet and press one arm straight out"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "推的时候肩和胯都朝正前方，别跟着转。",
    "en": "Shoulders and hips face straight ahead as you press. Don't twist."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "收回来慢一点，别让绳子把手拽回去。",
    "en": "Bring it back slowly. Don't let the cable yank your hand back."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "换手的时候，前后脚也换过来。",
    "en": "When you switch hands, switch your front foot too."
   }
  }
 ],
