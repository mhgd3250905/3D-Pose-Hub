   "primary": true,
   "text": {
    "zh": "双脚并拢，上面的膝盖慢慢向上打开",
    "en": "Keep your feet together and slowly open your top knee"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "侧躺，下面的前臂撑地，髋和膝弯着叠好。",
    "en": "Lie on your side on your bottom forearm, hips stacked, hips and knees bent."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "骨盆别往后翻，停一下再慢慢合上。",
    "en": "Do not let your hips roll back; pause, then close slowly."
   }
  }
 ],
