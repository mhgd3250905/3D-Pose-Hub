 "name": {
  "zh": "侧卧蚌式开合",
  "en": "Side-Lying Clamshell"
 },
 "purpose": {
  "zh": "激活臀部外侧，稳定髋关节",
  "en": "Wake up the side glutes and stabilise the hips."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "双脚并拢，上方膝盖慢慢向上打开",
    "en": "Keep your feet together and slowly open your top knee"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "侧卧，前臂撑地，髋部叠放，屈髋屈膝",
    "en": "Lie on your side on your forearm, hips stacked, hips and knees bent."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "骨盆不要向后翻，停一下再慢慢合上",
    "en": "Do not let your pelvis roll back; pause, then close slowly."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "骨盆跟着向后翻",
   "en": "Rolling the pelvis back."
  },
  {
   "zh": "双脚分开",
   "en": "Letting the feet come apart."
  }
 ],
 "cautions": [
  {
   "zh": "髋部疼痛时减小开合幅度，仍痛就停止",
   "en": "Open less if your hip hurts, and stop if the pain continues."
  }
 ],
