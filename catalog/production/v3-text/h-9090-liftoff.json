  "zh": "练后面那条腿的胯往里转的劲，让胯转得更开",
  "en": "Builds strength in your back leg's hip so your hips turn more freely."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "坐直，后腿膝盖贴地，把小腿和脚抬起来",
    "en": "Sit tall, back knee down, lift that shin and foot"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "前腿小腿横在身前，两手放在膝盖上。",
    "en": "Front shin across your body, hands on your knees."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "顶上停一下，再慢慢放下。",
    "en": "Pause at the top, then lower slowly."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "身子往后仰或歪着去抬脚",
   "en": "Leaning back or sideways to get the foot up."
  },
  {
   "zh": "后腿膝盖也跟着离地",
   "en": "Back knee coming off the floor."
  }
 ],
 "cautions": [
  {
   "zh": "胯或膝盖不舒服就抬低点，还疼就停",
   "en": "If your hip or knee feels off, lift lower. Stop if it still hurts."
  },
  {
   "zh": "抬不起来就两手撑在身后，能抬一点是一点",
   "en": "Can't lift it? Hands on the floor behind you and lift just a little."
  }
 ],
