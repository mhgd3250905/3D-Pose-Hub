   "text": {
    "zh": "两肘弯着，手放在后脖子附近，别碰头。",
    "en": "Elbows bent, hands near the back of your neck, not touching your head."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气。",
    "en": "Stay right there and breathe slowly."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "每次呼气再松一点，别一下一下往下压。",
    "en": "Each breath out, let go a little more. Don't bounce."
   }
  }
 ],
