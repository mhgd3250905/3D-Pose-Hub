 "name": {
  "zh": "门框双前臂胸部拉伸",
  "en": "Doorframe Forearm Chest Stretch"
 },
 "purpose": {
  "zh": "拉开胸口和肩膀前面",
  "en": "Stretches your chest and the fronts of your shoulders."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "两条小臂贴住门框，身子慢慢往门里探",
    "en": "Forearms on the doorframe, slowly lean through the doorway"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "前后脚站稳，脚别动。",
    "en": "Split stance, feet stay planted."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气。",
    "en": "Stay right there and breathe slowly."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "每次呼气再松一点，别一下一下往下压。",
    "en": "Each breath out, let go a little more. Don't bounce."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "肚子往前挺，胸口没打开",
   "en": "Pushing your belly forward instead of opening your chest."
  },
  {
   "zh": "憋气",
   "en": "Holding your breath."
  },
  {
   "zh": "一下一下往下压",
   "en": "Bouncing to go deeper."
  }
 ],
 "cautions": [
  {
   "zh": "拉到舒服就行，疼就松一点",
   "en": "Stretch only to a comfortable point. Ease off if anything hurts."
  },
  {
   "zh": "肩膀前面夹着疼就往前少探点，或把手臂放低",
   "en": "If the front of your shoulder pinches, lean in less or lower your arms."
  }
 ],
