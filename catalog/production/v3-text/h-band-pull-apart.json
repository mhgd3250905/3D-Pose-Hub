   "primary": true,
   "text": {
    "zh": "手臂伸直，把带子拉开成 T 字",
    "en": "Arms straight, pull the band apart into a T"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "肩胛骨往后往下夹，像要夹住一支笔。",
    "en": "Squeeze your shoulder blades back and down like you're pinching a pencil."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "肋骨别往外顶，慢慢收回来。",
    "en": "Keep your ribs down and bring it back slowly."
   }
  }
 ],
