   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "一侧做完，绑带换到另一只脚踝，人转过来面朝另一边。",
    "en": "When one side is done, strap the other ankle and turn around."
   }
  }
 ],
