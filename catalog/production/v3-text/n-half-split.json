 "name": {
  "zh": "半跪半劈叉（扶砖）",
  "en": "Half-Kneeling Half Split (Blocks)"
 },
 "purpose": {
  "zh": "拉开前腿大腿后面，给前后劈叉打底子",
  "en": "Stretches the back of your front thigh as a first step toward the front splits."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "屁股往后坐，前腿伸直，背拉长",
    "en": "Sit your hips back, straighten your front leg, keep your back long"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "后膝跪地，前脚后跟着地、勾脚尖。",
    "en": "Back knee down, front heel on the floor, toes up."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "弓背去够脚",
   "en": "Rounding your back to reach your foot."
  },
  {
   "zh": "硬把前腿膝盖伸直",
   "en": "Forcing your front knee straight."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "跪着的膝盖下面垫个软垫",
   "en": "Put a soft pad under your kneeling knee."
  },
  {
   "zh": "大腿后面疼就少往后坐点，还疼就停",
   "en": "If the back of your thigh hurts, don't sit back as far. Stop if it still hurts."
  }
 ],
