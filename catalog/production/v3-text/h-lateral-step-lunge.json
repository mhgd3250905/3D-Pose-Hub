 "name": {
  "zh": "侧跨步弓步蹲",
  "en": "Lateral Step Lunge"
 },
 "purpose": {
  "zh": "练大腿、屁股和大腿内侧，左右移动更稳",
  "en": "Builds your thighs, butt and inner thighs so side-to-side moves feel steadier."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "往旁边跨一大步，屁股往后坐到这条腿上",
    "en": "Step out wide and sit your hips back over that leg"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "另一条腿伸直，两只脚尖都朝前。",
    "en": "Other leg straight, both toes pointing forward."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "跨出去的脚一蹬回到站立，再换另一边。",
    "en": "Push off the stepping foot back to standing, then switch sides."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "两边各做一次算 1 下。",
    "en": "One on each side counts as one."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "膝盖往里倒",
   "en": "Knee caving in."
  },
  {
   "zh": "跨出去那只脚后跟抬起来",
   "en": "Heel of the stepping foot lifting."
  }
 ],
 "cautions": [
  {
   "zh": "膝盖不舒服就蹲浅点，还疼就停",
   "en": "If your knees feel off, don't go as low. Stop if it still hurts."
  }
 ],
