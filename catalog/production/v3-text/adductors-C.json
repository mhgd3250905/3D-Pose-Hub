 "name": {
  "zh": "绳索站姿髋内收",
  "en": "Standing Cable Hip Adduction"
 },
 "purpose": {
  "zh": "练大腿内侧，让腿往里并更有劲",
  "en": "Builds your inner thigh so you can pull your leg in with more strength."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "腿伸直，往里扫到支撑腿前面",
    "en": "Straight leg, sweep it across in front of your standing leg"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "侧对器械站，靠器械那只脚踝套上绑带。",
    "en": "Stand side-on to the machine, strap on the ankle nearest it."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "两边胯骨一样高，慢慢放回外边。",
    "en": "Keep both hips level and let the leg drift back out slowly."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "一边做完，绑带换到另一只脚，转过身再做。",
    "en": "When one side is done, move the strap to the other ankle and turn around."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "上身往一边歪着带腿",
   "en": "Leaning your upper body to swing the leg."
  },
  {
   "zh": "放回去时被绳子一下拽走",
   "en": "Letting the cable yank your leg back out."
  }
 ],
 "cautions": [
  {
   "zh": "疼就把动作做小点，还疼就停",
   "en": "If it hurts, make the move smaller. Stop if it still hurts."
  }
 ],
