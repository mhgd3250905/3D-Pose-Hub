 "name": {
  "zh": "90/90 坐姿拉胯",
  "en": "90/90 Hip Stretch"
 },
 "purpose": {
  "zh": "拉开前腿那边的屁股和胯外侧",
  "en": "Stretches the butt and outer hip of your front leg."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "背挺直，上身朝前腿小腿上方慢慢前倾",
    "en": "Long back, slowly lean forward over your front shin"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "前腿和侧腿都弯成直角，胸口对着前腿。",
    "en": "Both knees bent at right angles, chest facing your front shin."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "弓背往下压",
   "en": "Rounding your back to go deeper."
  },
  {
   "zh": "屁股离地歪向一边",
   "en": "Hips tipping off the floor."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "膝盖疼就少倾点或屁股下面垫高，还疼就停",
   "en": "If your knees hurt, lean less or sit on a cushion. Stop if it still hurts."
  }
 ],
