 "name": {
  "zh": "站姿举手侧屈",
  "en": "Standing Overhead Side Bend"
 },
 "purpose": {
  "zh": "拉开腰侧和背的侧面",
  "en": "Stretches the side of your waist and back."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "手臂举高，身子往另一边弯，胯别动",
    "en": "Reach one arm up and bend to the other side, hips still"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两脚跟胯一样宽，另一只手放在大腿外面。",
    "en": "Feet hip-width, other hand on the outside of your thigh."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "身子往前倒或扭了",
   "en": "Leaning forward or twisting."
  },
  {
   "zh": "胯往旁边甩出去",
   "en": "Swinging your hips out to the side."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "腰背或肩膀疼就弯小点，还疼就停",
   "en": "If your back or shoulder hurts, don't bend as far. Stop if it still hurts."
  }
 ],
