 "name": {
  "zh": "徒手早安式",
  "en": "Bodyweight Good Morning"
 },
 "purpose": {
  "zh": "练大腿后面和腰背，学会弯腰时背不弓",
  "en": "Builds your hamstrings and lower back, and teaches you to bend over without rounding."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "屁股往后推，上身像一块木板往前倒",
    "en": "Push your hips back and tip forward like a flat board"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两手轻放在脑后，手肘打开，膝盖微弯。",
    "en": "Hands lightly behind your head, elbows wide, knees soft."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "上身快到水平、大腿后面拉紧了就停，再站直。",
    "en": "Stop when your chest is nearly level and the backs of your thighs pull tight, then stand up."
   }
  }
 ],
 "commonErrors": [
