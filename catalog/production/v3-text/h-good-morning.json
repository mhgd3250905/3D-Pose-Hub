   "en": "Rounding your back."
  },
  {
   "zh": "蹲下去了",
   "en": "Turning it into a squat."
  }
 ],
 "cautions": [
  {
   "zh": "腰不舒服就往下少弯点，还疼就停",
   "en": "If your lower back feels off, don't bend as far. Stop if it still hurts."
  },
  {
   "zh": "手别使劲压脑袋",
   "en": "Don't pull on your head with your hands."
  }
 ],
