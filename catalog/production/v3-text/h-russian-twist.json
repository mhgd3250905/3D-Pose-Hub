   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "上身往后靠、背挺直，胸口慢慢转向一边",
    "en": "Lean back with a long back and slowly turn your chest to one side"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "膝盖和屁股朝前不动，脚后跟踩地。",
    "en": "Knees and hips face forward, heels on the floor."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "回到中间，再转另一边。",
    "en": "Come back to the middle, then turn the other way."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "两边各转一次算 1 下。",
    "en": "One turn each side counts as one."
   }
  }
 ],
