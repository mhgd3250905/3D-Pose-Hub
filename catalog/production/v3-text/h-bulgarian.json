  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "身子直直往下沉，前膝对着脚尖",
    "en": "Drop straight down, front knee over your toes"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "后脚脚背搭在椅面上，前脚后跟踩稳。",
    "en": "Top of your back foot on the seat, front heel planted."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "蹲到前大腿差不多跟地面平，再用前脚后跟蹬起来。",
    "en": "Lower until your front thigh is about level with the floor, then push up through your front heel."
   }
  }
 ],
 "commonErrors": [
