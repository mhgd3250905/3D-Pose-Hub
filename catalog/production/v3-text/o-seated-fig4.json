 "name": {
  "zh": "坐姿四字前压",
  "en": "Seated Figure-4 Stretch"
 },
 "purpose": {
  "zh": "拉开屁股，久坐胯发紧时松一松",
  "en": "Stretches your butt to ease tight hips from sitting."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "一只脚踝搭在另一边膝盖上，背挺直往前倾",
    "en": "Cross one ankle over the other knee and lean forward with a long back"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "另一只脚踩平，翘起的膝盖自然往外打开。",
    "en": "Other foot flat, let the crossed knee fall open."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "弓背往下压",
   "en": "Rounding your back to go deeper."
  },
  {
   "zh": "用手硬压膝盖",
   "en": "Forcing your knee down with your hand."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "膝盖疼就少往前倾点，还疼就停",
   "en": "If your knee hurts, don't lean as far. Stop if it still hurts."
  }
 ],
