 "name": {
  "zh": "半跪髋前侧拉伸",
  "en": "Half-Kneeling Hip Stretch"
 },
 "purpose": {
  "zh": "拉开胯前面，久坐发紧时松一松",
  "en": "Stretches the front of your hip to ease tightness from sitting."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "夹紧屁股，身子慢慢往前推",
    "en": "Squeeze your butt and slowly shift forward"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "后膝跪地，前脚踩地，上身直立。",
    "en": "Back knee down, front foot planted, upper body tall."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "拱腰往前，屁股没夹",
   "en": "Arching your lower back instead of squeezing your butt."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "跪着的膝盖下面垫软垫",
   "en": "Pad under your kneeling knee."
  },
  {
   "zh": "胯前面疼就推少点，还疼就停",
   "en": "If the front of your hip hurts, don't push as far. Stop if it still hurts."
  }
 ],
