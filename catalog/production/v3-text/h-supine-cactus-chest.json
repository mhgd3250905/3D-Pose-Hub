   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "有一点拉的感觉就停住，再慢慢滑回来。",
    "en": "Stop at a mild stretch, then slide back down slowly."
   }
  }
 ],
