 "name": {
  "zh": "哑铃地板卧推",
  "en": "Dumbbell Floor Press"
 },
 "purpose": {
  "zh": "练胸和大臂后面",
  "en": "Builds your chest and the backs of your arms."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "慢慢放到大臂碰地，再推回肩膀正上方",
    "en": "Lower until your upper arms touch the floor, then press back over your shoulders"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "手腕在手肘正上方，大臂跟身体斜着分开，别张成一字。",
    "en": "Wrists over your elbows. Upper arms angled out from your body, not straight out to the sides."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "碰地轻轻停一下，别弹起来。",
    "en": "Pause lightly on the floor. No bouncing."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "手肘往两边张得太开",
   "en": "Elbows flaring way out."
  },
  {
   "zh": "手腕往后折",
   "en": "Wrists bending back."
  }
 ],
 "cautions": [
  {
   "zh": "先用轻哑铃，哪儿疼就停",
   "en": "Start with light dumbbells. Stop if anything hurts."
