 "name": {
  "zh": "哑铃罗马尼亚硬拉",
  "en": "Dumbbell Romanian Deadlift"
 },
 "purpose": {
  "zh": "练大腿后面和屁股，学会弯腰时背不弓",
  "en": "Builds your hamstrings and butt, and teaches you to bend over without rounding your back."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "屁股往后推，背挺平，哑铃贴着腿往下滑",
    "en": "Push your hips back, flat back, slide the weights down your legs"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "膝盖微弯，但别往下蹲。",
    "en": "Soft knees, but don't squat."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "哑铃过膝盖、大腿后面拉紧了就停，再站直。",
    "en": "Stop just past your knees when the backs of your thighs pull tight, then stand up."
   }
  }
 ],
