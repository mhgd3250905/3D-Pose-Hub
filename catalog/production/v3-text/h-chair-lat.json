 "name": {
  "zh": "扶椅侧背拉伸",
  "en": "Chair-Supported Lat Stretch"
 },
 "purpose": {
  "zh": "拉开从腋下到身体两侧的后背",
  "en": "Stretches from your armpits down the sides of your back."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "屁股往后推，胸口在两臂中间往下沉",
    "en": "Push your hips back, let your chest sink between your arms"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两手扶椅背，手臂伸直，膝盖微弯。",
    "en": "Hands on the chair back, arms straight, knees soft."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "屁股继续往后拉，腋下到腰侧一路被拉长。",
    "en": "Keep pulling your hips back and feel your side stretch from armpit to waist."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "呼气时胸口往地上再沉一点，手别离开椅子。",
    "en": "Each breath out, drop your chest a little lower, hands stay on the chair."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "弓背或耸肩",
   "en": "Rounding your back or shrugging."
  },
  {
   "zh": "憋气",
   "en": "Holding your breath."
  },
  {
   "zh": "耸着肩，脑袋缩在两臂中间",
   "en": "Shoulders shrugged up, head tucked between your arms."
  }
 ],
 "cautions": [
  {
   "zh": "肩膀前面夹着疼就把手放宽，往后少推点",
   "en": "If your shoulders pinch, widen your hands and don't push back as far."
  },
  {
   "zh": "椅子顶住墙，压上去不会往前跑",
   "en": "Brace the chair against a wall so it won't slide."
  }
 ],
