 "name": {
  "zh": "仰卧弹力带单腿向外落",
  "en": "Lying Band Leg Drop-Out"
 },
 "purpose": {
  "zh": "拉开大腿内侧和大腿后面",
  "en": "Stretches your inner thigh and the back of your thigh."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "膝盖伸直，腿慢慢往外边落",
    "en": "Knee straight, slowly let the leg fall out to the side"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "手拉住带子，让带子托着腿的重量。",
    "en": "Hold the band so it carries the weight of your leg."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "腿落到有拉的感觉就停，用带子托住它。",
    "en": "Let your leg drop until you feel the stretch, and let the band hold it."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "呼气时手上的带子松一点，让腿再往外落一点。",
    "en": "On each breath out, give the band a little slack so your leg drops further."
   }
  }
 ],
