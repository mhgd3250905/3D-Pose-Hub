  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "膝盖不用抬太高，先把重心挪到站着那条腿再抬。",
    "en": "Knee only a little high. Shift onto your standing leg first, then lift."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "两边各抬一次算 1 下，下一组换手提。",
    "en": "One lift each side counts as one. Switch hands next set."
   }
  }
 ],
