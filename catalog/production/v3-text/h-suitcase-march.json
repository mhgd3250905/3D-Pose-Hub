  "zh": "练侧腰和屁股，单手拎东西走路身子更稳",
  "en": "Builds the sides of your waist and your butt so you stay steady walking with weight in one hand."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "一手提哑铃，两腿轮流抬膝，胯别歪",
    "en": "Dumbbell in one hand, march in place, don't let your hips tip"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "上身挺直，别往一边歪。",
    "en": "Stand tall, don't lean to one side."
   }
