 "name": {
  "zh": "扶墙俯身拉背",
  "en": "Wall-Supported Back Stretch"
 },
 "purpose": {
  "zh": "拉开背两边和腋下",
  "en": "Stretches the sides of your back and your armpits."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "两手扶墙，屁股往后挪，胸口往下沉",
    "en": "Hands on the wall, push your hips back and let your chest sink"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两手跟胸口一样高，两脚踩稳，膝盖微弯。",
    "en": "Hands at chest height, feet planted, knees soft."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "塌腰硬压",
   "en": "Sagging your lower back to force it."
  },
  {
   "zh": "耸肩",
   "en": "Shrugging your shoulders."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "肩膀疼就沉少点，还疼就停",
   "en": "If your shoulders hurt, don't sink as far. Stop if it still hurts."
  }
 ],
