  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "手肘贴身弯成直角，小臂往肚子转",
    "en": "Elbow bent at your side, turn your forearm in to your belly"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "侧对拴带的地方站直，膝盖微微松开。",
    "en": "Stand tall side-on to the anchor, knees soft."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "停一下，再慢慢转回去。",
    "en": "Pause, then turn back slowly."
   }
  }
 ],
 "commonErrors": [
