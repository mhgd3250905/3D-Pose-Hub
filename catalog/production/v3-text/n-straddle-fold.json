 "name": {
  "zh": "坐姿分腿体前屈",
  "en": "Seated Straddle Forward Fold"
 },
 "purpose": {
  "zh": "拉开大腿内侧和后面",
  "en": "Stretches your inner thighs and the backs of your thighs."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "背拉长，上身慢慢往前倾",
    "en": "Long back, slowly lean forward"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "坐在垫子上，两腿伸直分开，脚尖和膝盖朝上。",
    "en": "Sit with your legs straight and wide, toes and kneecaps up."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "弓背去够地",
   "en": "Rounding your back to reach the floor."
  },
  {
   "zh": "膝盖往里倒",
   "en": "Knees rolling in."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "拉的地方疼就少往前倾点，还疼就停",
   "en": "If the stretch hurts, don't lean as far. Stop if it still hurts."
  }
 ],
