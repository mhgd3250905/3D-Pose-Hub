 "name": {
  "zh": "V撑",
  "en": "V-Sit"
 },
 "purpose": {
  "zh": "练把两腿高高抬起、贴近身子的劲",
  "en": "Builds the strength to pull your legs up high toward your body."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "大腿往胸口折，两腿抬高成 V 字",
    "en": "Fold your thighs toward your chest and lift your legs into a V"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "两手撑地，肩膀往下压。",
    "en": "Hands on the floor, shoulders pressed down."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "靠大腿往胸口收来抬腿，别整个人往后倒。",
    "en": "Lift by pulling your thighs to your chest, not by leaning your whole body back."
   }
  }
 ],
 "commonErrors": [
