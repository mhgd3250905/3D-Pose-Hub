   "zh": "整个人往后倒",
   "en": "Leaning your whole body back."
  },
  {
   "zh": "耸肩",
   "en": "Shrugging."
  }
 ],
 "cautions": [
  {
   "zh": "手撑在身后吃重量，先转转手腕",
   "en": "Your hands carry weight behind you, so roll out your wrists first."
  },
  {
   "zh": "手腕或肩膀疼就少撑几秒，还疼就停；做不到就弯着膝盖做",
   "en": "If your wrists or shoulders hurt, hold for less time. Stop if it still hurts. Can't get there? Bend your knees."
  }
 ],
