 "name": {
  "zh": "扶椅站姿交叉侧伸",
  "en": "Chair-Supported Cross-Leg Side Reach"
 },
 "purpose": {
  "zh": "拉开胯外侧和腰侧",
  "en": "Stretches the outside of your hip and the side of your waist."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "胯往外推，身子往椅子那边弯",
    "en": "Push your hip out and lean toward the chair"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "离椅子远的那条腿交叉到后面，另一只手举过头。",
    "en": "Cross the far leg behind, reach the other arm overhead."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "胯往外推出去，从腋下到胯边一路有拉的感觉。",
    "en": "Push your hip out and feel the stretch from armpit to hip."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "呼气时举高的手再往椅子那边够远一点。",
    "en": "Each breath out, reach your top hand a little further toward the chair."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "身子往前倒",
   "en": "Leaning forward instead of sideways."
  },
  {
   "zh": "把重量全压在椅子上",
   "en": "Putting all your weight on the chair."
  },
  {
   "zh": "上身往前塌，不是侧着弯",
   "en": "Folding forward instead of bending sideways."
  }
 ],
 "cautions": [
  {
   "zh": "胯或腰疼就弯小点，还疼就停",
   "en": "If your hip or back hurts, don't bend as far. Stop if it still hurts."
  }
 ],
