 "name": {
  "zh": "靠墙小腿拉伸",
  "en": "Wall Calf Stretch"
 },
 "purpose": {
  "zh": "拉开小腿后面，脚踝更灵活",
  "en": "Stretches the back of your calf and loosens your ankle."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "后腿伸直，脚后跟踩地，屁股往墙那边靠",
    "en": "Back leg straight, heel down, lean your hips toward the wall"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "后脚尖正对墙，从脚后跟到头一条线。",
    "en": "Back toes point at the wall, one line from heel to head."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "后脚尖正冲着墙，别往外撇。",
    "en": "Back toes point at the wall, don't turn them out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "呼气时前膝往墙再弯一点，后脚跟一直踩实。",
    "en": "Each breath out, bend your front knee toward the wall, back heel stays down."
   }
  }
 ],
 "commonErrors": [
