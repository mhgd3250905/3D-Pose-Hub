 "name": {
  "zh": "单腿站三方向点地",
  "en": "Single-Leg Three-Way Toe Tap"
 },
 "purpose": {
  "zh": "练单腿站稳，胯不歪",
  "en": "Builds balance on one leg with your hips staying level."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "单腿站稳，另一只脚轻点前面、旁边、后面",
    "en": "Balance on one leg and lightly tap your other foot in front, to the side and behind"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "点地时别把重量压过去，胯别歪。",
    "en": "Don't put weight on the tapping foot. Hips stay level."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "站着那条腿膝盖微弯，对着脚尖。",
    "en": "Standing knee soft and over your toes."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "点一次算 1 下，前、旁、后轮流点。",
    "en": "Each tap counts as one. Go front, side, back in turn."
   }
  }
 ],
