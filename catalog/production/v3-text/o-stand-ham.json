 "name": {
  "zh": "扶椅站姿大腿后侧拉伸",
  "en": "Chair-Supported Standing Hamstring Stretch"
 },
 "purpose": {
  "zh": "站着拉开大腿后面",
  "en": "Stretches the back of your thigh while standing."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "前脚后跟着地、勾脚尖，上身稍往前倾",
    "en": "Front heel down, toes up, lean forward a little"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "一手扶稳椅子，站着那条腿膝盖微弯。",
    "en": "One hand on a sturdy chair, standing knee soft."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "就停在这儿，慢慢喘气，每次呼气再松一点。",
    "en": "Stay right there, breathe slowly, let go a little more each breath out."
   }
  },
  {
   "id": "cue4",
   "primary": false,
   "text": {
    "zh": "别一下一下往下压，有拉的感觉就够，别拉到疼。",
    "en": "Don't bounce. A clear stretch is enough, never pain."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "弓背去够",
   "en": "Rounding your back to reach down."
  },
  {
   "zh": "前腿膝盖锁死往后顶",
   "en": "Locking your front knee back."
  },
  {
   "zh": "憋气或一下一下往下压",
   "en": "Holding your breath or bouncing."
  }
 ],
 "cautions": [
  {
   "zh": "大腿后面疼或发麻就少往前倾点，还不舒服就停",
   "en": "If the back of your thigh hurts or tingles, don't lean as far. Stop if it still feels off."
  }
 ],
