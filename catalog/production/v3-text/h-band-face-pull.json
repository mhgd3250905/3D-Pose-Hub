  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "把弹力带拉向面部，肘向两侧抬高",
    "en": "Pull the band toward your face with your elbows high and wide"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "肩胛向后收，肩膀不耸起",
    "en": "Squeeze your shoulder blades back without shrugging."
   }
