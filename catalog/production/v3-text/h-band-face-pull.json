 "name": {
  "zh": "站姿弹力带面拉",
  "en": "Standing Band Face Pull"
 },
 "purpose": {
  "zh": "练上背和肩膀后面，老含胸驼背的人尤其该练",
  "en": "Builds your upper back and the back of your shoulders, great if you tend to slouch."
 },
 "cues": [
  {
   "id": "cue1",
   "primary": true,
   "text": {
    "zh": "把带子拉向脸，手肘抬高往两边开",
    "en": "Pull the band to your face, elbows high and wide"
   }
  },
  {
   "id": "cue2",
   "primary": false,
   "text": {
    "zh": "肩胛骨往后夹，肩膀别耸。",
    "en": "Pinch your shoulder blades back. No shrugging."
   }
  },
  {
   "id": "cue3",
   "primary": false,
   "text": {
    "zh": "慢慢放回去，直到手臂伸直。",
    "en": "Let it back slowly until your arms are straight."
   }
  }
 ],
 "commonErrors": [
  {
   "zh": "身子往后仰着拉",
   "en": "Leaning back to pull."
  },
  {
   "zh": "耸肩",
   "en": "Shrugging."
  }
 ],
 "cautions": [
  {
   "zh": "带子拴在脸的高度，先用力拽一下试试牢不牢",
   "en": "Anchor the band at face height and test it with a hard tug."
  },
  {
   "zh": "肩膀前面夹着疼就拉低一点，换细的带子",
   "en": "If the front of your shoulder pinches, pull a bit lower and use a lighter band."
  }
 ],
